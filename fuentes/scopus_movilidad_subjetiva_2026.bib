	affiliations = {Business School, Beijing Normal University, Beijing, China; Department of Psychology, Faculty of Arts and Sciences, Beijing Normal University, Zhuhai, China; Beijing Key Laboratory of Applied Experimental Psychology, National Demonstration Center for Experimental Psychology Education, Faculty of Psychology, Beijing Normal University, Beijing, China; School of Business, University of Leicester, Leicestershire, United Kingdom; Institute of Advanced Studies in Humanities and Social Sciences, Beijing Normal University, Zhuhai, China; Department of Psychology, University of Hong Kong, Hong Kong},
	abstract = {Individuals may consider socioeconomic status (SES) change from an absolute or relative standpoint. Across five studies and supplementary analyses of secondary data, we found that individuals who perceive SES as being unlikely to change (i.e., low perceived social mobility) tend to consider SES change from a relative standpoint—i.e., one person’s gain in SES occurs at the expense of another’s loss in SES—reflecting that they harbor zero-sum beliefs regarding social hierarchies. In other words, the extent to which individuals believe that society is mobile predicts how they consider the nature of social mobility. This relationship is mediated by a scarcity mindset and further predicts the tendency for aggression. The findings held when we controlled for variables such as perceived economic inequality, income, and education. © 2024 by the Society for Personality and Social Psychology, Inc},
