	author = {Wang, Xue and Chen, Wei-Fen and Hong, Ying-Yi and Chen, Zhansheng},
	title = {Perceiving high social mobility breeds materialism: The mediating role of socioeconomic status uncertainty},
	year = {2022},
	journal = {Journal of Business Research},
	volume = {139},
	pages = {629 - 638},
	doi = {10.1016/j.jbusres.2021.10.014},
	url = {https://www.scopus.com/pages/publications/85133351210?origin=resultslist},
	affiliations = {Business School, Beijing Normal University, No.19 XinJieKouWai Street, Haidian District, Beijing, 100875, China; University of Leicester School of Business, Brookfield, 266 London Road, Leicester, LE2 1RQ, United Kingdom; Department of Management, CUHK Business School, The Chinese University of Hong Kong, Shatin, Hong Kong; Department of Psychology, The University of Hong Kong, Hong Kong},
	abstract = {The present research explored whether and how consumers with high levels of perceived social mobility (PSM) would endorse materialism, an under-researched effect that is not contingent on either their current socioeconomic status (SES) or anticipated social mobility trajectories. Four mixed-methods studies, comprising two large-scale surveys and two experiments, yielded convergent evidence that consumers who perceived a higher level of social mobility more strongly endorsed materialistic values. We traced this effect to consumers’ SES uncertainty. The effect of PSM on materialism was attenuated when SES uncertainty was mitigated. Our findings demonstrate that consumers may become more materialistic to relieve uncertainty about their SES. We also offer guidance for practitioners on integrating PSM when planning marketing strategies. © 2021 Elsevier Inc.},
	author_keywords = {Identity; Materialism; Perceived social mobility; Socioeconomic status; Uncertainty},
