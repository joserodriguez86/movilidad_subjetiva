@ARTICLE{Lu2026288,
	author = {Lu, Haiyang and Ishida, Kenji and Zeng, Keya and Hu, Weiliang},
	title = {From disillusionment to devotion: How perceptions of social mobility influence religious beliefs through attitudes toward government in China},
	year = {2026},
	journal = {International Sociology},
	volume = {41},
	number = {3},
	pages = {288 - 320},
	doi = {10.1177/02685809261432518},
	url = {https://www.scopus.com/pages/publications/105035399605?origin=resultslist},
	affiliations = {Institute of Western China Economic Research, Southwestern University of Finance and Economics, China; Institute of Social Science, The University of Tokyo, Japan},
	abstract = {While interest in the determinants of religiosity has grown, few studies have explored the role of social mobility in shaping religious beliefs. This study examines the relationship between perceptions of upward and downward social mobility (PUSM/PDSM) and religiosity in China using a diagonal reference model. Drawing on the Chinese Social Survey, we found no significant relationship between PUSM and religious beliefs, whereas PDSM was positively associated with religiosity. Further analysis revealed that political trust and perceptions of government performance mediated the link between PDSM and religious beliefs. These findings highlight religion’s role as a coping mechanism during socioeconomic hardship, suggesting that faith in a higher power may compensate for declining trust in political institutions. Given China’s strong secular tradition, stringent religious regulations, and the availability of alternative coping mechanisms, it is unlikely that religiosity will see a significant rise in the near future despite potential growth at the grassroots level. © The Author(s) 2026; Résumé Alors que l’intérêt pour les déterminants de la religiosité s’est accru, peu d’études ont été consacrées au rôle de la mobilité sociale dans la formation des croyances religieuses. Cette étude examine à l’aide d’un modèle de référence diagonal la relation entre les perceptions de mobilité sociale ascendante et descendante et la religiosité en Chine. En utilisant les données de l’Enquête sociale chinoise, nous n’avons trouvé aucun lien significatif entre mobilité sociale ascendante et croyances religieuses, tandis que la mobilité sociale descendante apparaissait incontestablement associée à la religiosité. Une analyse plus approfondie a révélé que la confiance politique et la perception de l’action gouvernementale facilitaient le lien entre mobilité sociale descendante et croyances religieuses. Ces résultats mettent en évidence le rôle de la religion comme mécanisme d’adaptation pendant les périodes de difficultés socio-économiques, ce qui tend à indiquer que la foi en une puissance supérieure peut compenser la baisse de confiance dans les institutions politiques. Compte tenu de la forte tradition laïque de la Chine, des réglementations religieuses strictes et de l’existence d’autres mécanismes d’adaptation, il est peu probable que la religiosité connaisse une augmentation significative dans un avenir proche, malgré une croissance potentielle au niveau local. © The Author(s) 2026; Resumen Si bien ha aumentado el interés por los determinantes de la religiosidad, pocos estudios han explorado el papel de la movilidad social en la formación de las creencias religiosas. Este artículo examina la relación entre las percepciones de movilidad social ascendente y descendente y la religiosidad en China utilizando un modelo de referencia diagonal. Usando datos de la Encuesta Social China, no se ha encontrado una relación significativa entre la percepción de movilidad social ascendente y las creencias religiosas, mientras que la percepción de movilidad social descendente se asocia positivamente con la religiosidad. Un análisis más detallado revela que la confianza política y las percepciones sobre el desempeño del gobierno median el vínculo entre la percepción de movilidad social descendente y las creencias religiosas. Estos hallazgos resaltan el papel de la religión como mecanismo para afrontar periodos de dificultades socioeconómicas, lo que sugiere que la fe en un poder superior puede compensar la disminución de la confianza en las instituciones políticas. Dada la sólida tradición secular de China, las estrictas regulaciones de la religión y la disponibilidad de mecanismos alternativos para afrontar las dificultades, es improbable que la religiosidad experimente un aumento significativo en el futuro cercano, a pesar del potencial crecimiento a nivel de base. © The Author(s) 2026},
	author_keywords = {Diagonal reference model; government performance; political trust; religiosity; social mobility},
	correspondence_address = {W. Hu; Institute of Western China Economic Research, Southwestern University of Finance and Economics, Chengdu, 555 Liutai Avenue, Wenjiang District, Sichuan, 611130, China; email: 221095137075@smail.swufe.edu.cn},
	publisher = {SAGE Publications Ltd},
