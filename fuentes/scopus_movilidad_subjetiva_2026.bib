	issn = {13696866},
	language = {English},
	abbrev_source_title = {Int. J. Soc. Welf.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 25; All Open Access; Bronze Open Access; Green Open Access}
}

@ARTICLE{Yuan2019,
