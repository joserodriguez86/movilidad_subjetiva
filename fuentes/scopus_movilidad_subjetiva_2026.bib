@ARTICLE{Srivastava2025,
	author = {Srivastava, Manishi and Grütter, Jeanine and Bhatta, Pramod},
	title = {Adolescents’ beliefs about caste-essentialism and their social location in Nepal},
	year = {2025},
	journal = {Cognitive Development},
