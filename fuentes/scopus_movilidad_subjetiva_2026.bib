@ARTICLE{Tagaev2026250,
	author = {Tagaev, B. and Bilan, Y.},
	title = {AI ADOPTION AND HUMAN CAPITAL DEVELOPMENT IN TRANSITION ECONOMIES: EVIDENCE FROM UZBEKISTAN; [SZTUCZNA INTELIGENCJA, KAPITAŁ LUDZKI I MOBILNOŚĆ SPOŁECZNA W GOSPODARKACH W FAZIE TRANSFORMACJI: DOŚWIADCZENIA UZBEKISTANU]},
