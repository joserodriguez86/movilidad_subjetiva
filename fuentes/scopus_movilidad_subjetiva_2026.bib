@ARTICLE{Swan2017507,
	author = {Swan, Lawton K. and Chambers, John R. and Heesacker, Martin and Nero, Sondre S.},
	title = {How should we measure Americans’ perceptions of socio-economic mobility?},
	year = {2017},
	journal = {Judgment and Decision Making},
	volume = {12},
