	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 16; All Open Access; Bronze Open Access}
}

@ARTICLE{Su2015315,
	author = {Su, Zhenhua and Cao, Yang and He, Jingkai},
	title = {Perceived social mobility and political trust in China},
	year = {2015},
	journal = {African and Asian Studies},
	volume = {14},
	number = {4},
	pages = {315 - 336},
	doi = {10.1163/15692108-12341347},
	url = {https://www.scopus.com/pages/publications/84953707587?origin=resultslist},
	affiliations = {Department of Political Economy, College of Public Affairs, Zhejiang University, China; Department of Sociology, University of North Carolina at Charlotte, Charlotte, NC, United States; Department Sociology, Zhejiang University, China; Department of Government, Harvard University, United States},
	abstract = {Existing studies have traced China's high political trust to three sources: traditional culture, the state's success in fostering economic growth, and ideological propaganda. We identify a fourth source: perceived social mobility. We argue that when people perceive a reasonable chance for upward mobility based on personal initiatives and efforts, the status quo becomes more justifiable because individuals are responsible for their own successes and failures. Perceived social mobility thus instills a sense of optimism and fairness and exonerates the regime from many blames, thereby enhancing political trust. Regression analysis of the China portion of the 2007 World Values Survey data shows that respondents who saw themselves as having choices and control in life were indeed more likely to trust the ruling communist party. The respondents' overall level of perceived social mobility is also high, which is consistent with the massive shake-up of the preexisting social order in China's reform era. © 2015 Koninklijke Brill NV, Leiden, The Netherlands.},
	author_keywords = {China; political trust; social mobility},
	keywords = {China; party politics; political system; social mobility; social theory},
	correspondence_address = {Z. Su; Department of Political Economy, College of Public Affairs, Zhejiang University, China; email: suzh@zju.edu.cn},
	publisher = {Brill Academic Publishers},
	issn = {15692094},
	language = {English},
	abbrev_source_title = {Afr. Asian Stud.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 8}
}

