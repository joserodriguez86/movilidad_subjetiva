@ARTICLE{Lu2025573,
	author = {Lu, Haiyang and Hu, Weiliang and Zeng, Keya},
	title = {Rethinking mobility’s impact: Social mobility, fairness, and life satisfaction in contemporary China},
	year = {2025},
	journal = {International Sociology},
	volume = {40},
	number = {4 Special Thematic Section: How does moralization work? Exploring the operational logics of morality},
	pages = {573 - 607},
	doi = {10.1177/02685809251348929},
	url = {https://www.scopus.com/pages/publications/105013048528?origin=resultslist},
	affiliations = {Institute of Western China Economic Research, Southwestern University of Finance and Economics, China},
	abstract = {Since Sorokin’s seminal work, many studies have explored the psychological outcomes of social mobility, with mixed results. Most of the previous research has been limited by methodological issues that prevent them from distinguishing the contributions of mobility from social status. We examined the relationship between perceptions of upward and downward social mobility and life satisfaction using diagonal reference model, a methodology that permits to estimate the separate effects of origin class, destination class, and social mobility. Based on nationally representative data from the 2019 and 2021 Chinese Social Survey, we found that perceptions of upward social mobility was associated with higher life satisfaction, while perceptions of downward social mobility was associated with lower life satisfaction. Mechanism analyses suggested that perceived fairness mediated the nexus between perceptions of upward and downward social mobility and life satisfaction. This study enhances our understanding of the association between social mobility and human well-being, elucidating the micro-level psychological mechanisms underlying this relationship. © The Author(s) 2025; Depuis les travaux fondateurs de Sorokin, de nombreuses études ont été consacrées aux effets psychologiques de la mobilité sociale, avec des résultats contrastés. La plupart des recherches passées ont été limitées par des problèmes méthodologiques qui empêchent de distinguer les effets de la mobilité de ceux du statut social. Dans cet article, nous avons examiné la relation entre les perceptions de mobilité sociale ascendante et descendante et la satisfaction de la vie en utilisant le modèle de référence diagonale (diagonal reference model), une méthodologie qui permet d’évaluer séparément les effets de la classe d’origine, de la classe de destination et de la mobilité sociale. Sur la base de données représentatives au niveau national de l’Enquête sociale chinoise de 2019 et 2021, nous avons constaté que la mobilité sociale ascendante était associée à une plus grande satisfaction de la vie, tandis que la mobilité sociale descendante était associée à une plus faible satisfaction dans la vie. Les analyses mécanistes semblent indiquer que l’équité perçue facilite le lien entre mobilité sociale ascendante/descendante et satisfaction de la vie. Cette étude permet de mieux comprendre l’association entre mobilité sociale et bien-être humain, en élucidant les mécanismes psychologiques qui sous-tendent cette relation au niveau micro. © The Author(s) 2025; Desde el trabajo seminal de Sorokin, numerosos estudios han explorado las consecuencias psicológicas de la movilidad social, con resultados dispares. La mayor parte de la investigación previa se ha visto limitada por problemas metodológicos que impiden distinguir el efecto de la movilidad del efecto del estatus social. Este artículo examina la relación entre las percepciones de movilidad social ascendente y descendente y la satisfacción vital usando el diagonal reference model (modelo que toma como referencia la diagonal de la tabla de movilidad), una metodología que permite estimar por separado los efectos de la clase de origen, la clase de destino y la movilidad social. Usando datos representativos a nivel nacional de la Encuesta Social China de 2019 y 2021, se ha hallado que la percepción de movilidad social ascendente se asocia con una mayor satisfacción vital, mientras que la percepción de movilidad social descendente se asocia con una menor satisfacción vital. Los análisis mecanicistas sugieren que la justicia percibida es un mediador de la relación entre la percepción de movilidad social ascendente y descendente y la satisfacción vital. Este estudio profundiza en nuestra comprensión de la asociación entre la movilidad social y el bienestar humano, dilucidando los mecanismos psicológicos que explican esta relación a nivel micro. © The Author(s) 2025},
	author_keywords = {China; diagonal reference model; life satisfaction; perceived fairness; social mobility},
	correspondence_address = {K. Zeng; Institute of Western China Economic Research, Southwestern University of Finance and Economics, Chengdu, 555 Liutai Avenue, Wenjiang District, Sichuan Province, 611130, China; email: zengkeya@163.com},
	publisher = {SAGE Publications Ltd},
