@ARTICLE{Huang2024,
	author = {Huang, Simin and Yang, Lin and Yang, Chen and Wang, Donghan and Li, Yiming},
	title = {Obscuring effect of income inequality and moderating role of financial literacy in the relationship between digital finance and China's household carbon emissions},
	year = {2024},
