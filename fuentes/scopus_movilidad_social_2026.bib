	issn = {03750922},
	coden = {RHLCA},
	language = {Slovak},
	abbrev_source_title = {Rehabilitacia},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Hybrid Gold Open Access}
}

