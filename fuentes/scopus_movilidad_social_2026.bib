@ARTICLE{Hällsten2017328,
	author = {Hällsten, Martin and Pfeffer, Fabian T.},
	title = {Grand Advantage: Family Wealth and Grandchildren’s Educational Achievement in Sweden},
	year = {2017},
	journal = {American Sociological Review},
	volume = {82},
	number = {2},
	pages = {328 - 360},
