	correspondence_address = {Y.G. Yi; Department of Rehabilitation Medicine, Ewha Womans University Seoul Hospital, Ewha Womans University School of Medicine, Seoul, 25, Magokdong-ro 2-gil, Gangseo-gu, 07804, South Korea; email: lyk861124@gmail.com},
