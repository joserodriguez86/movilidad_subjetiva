	language = {English},
	abbrev_source_title = {J. Hist. Res. Mark.},
	type = {Article},
	publication_stage = {Article in press},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Hybrid Gold Open Access}
}

@ARTICLE{Ruggera2025102,
