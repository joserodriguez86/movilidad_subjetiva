	title = {Adult temporal mobility (2002-2010) in material wealth and physical health, self-perceived health, sociality, and use of addictive substances: Insights from an observational exploratory panel study among Tsimane’ Indigenous People in the Bolivian Amazon},
	year = {2026},
	journal = {Social Science and Medicine},
	volume = {407},
	pages = {},
	doi = {10.1016/j.socscimed.2026.119696},
	url = {https://www.scopus.com/pages/publications/105048626562?origin=resultslist},
	affiliations = {Department of Agricultural Economics, Purdue University, West Lafayette, 47907, IN, United States; Heller School for Social Policy and Management, Brandeis University, Waltham, 02453, MA, United States; Department of Anthropology and Program in Global Health Studies, Northwestern University, Evanston, 60208, IL, United States; Institución Catalana de Recerca i Estudis Avançats (ICREA), Barcelona, Spain; Institute of Environmental Science and Technology and Department of Anthropology, Universitat Autònoma de Barcelona, Cerdanyola del Valles, Barcelona, 08193, Spain; Department of Biobehavioral Health and Department of Anthropology, Pennsylvania State University, University Park, 16802, PA, United States; Escuela de Gobierno and SENTINET, Pontificia Universidad Católica de Chile, Santiago, 7820436, Chile},
	abstract = {Changes in relative socioeconomic rank during adulthood (intragenerational mobility) are increasingly recognized as important determinants of health and other well-being indicators. Quantitative studies in high-income countries find that mobility in rank generally correlates with these outcomes, but the direction and mechanisms remain unclear. Evidence from small-scale societies is scarcer due to limited panel data. We examine the correlation between mobility and well-being indicators among 350 Tsimane’ adults (age≥16y: women = 184; men = 166) in the Bolivian Amazon, using nine consecutive years of panel data (2002–2010). Guided by four theories (dissociation [any mobility harms], socialization [people adapt to any new rank], “falling from grace” [extreme downward mobility harms], and set-point [“effects” are temporary]) we assess how changes in quintile rank of material wealth correlate with four aspects of well-being in 2010: physical health, perceived health, sociality, and use of addictive substances. Results showed partial support for each theory and revealed that upward and downward mobility each correlated with a mix of favorable (e.g., lower likelihood of being overweight, greater food satisfaction) and unfavorable (e.g., increased anger) indicators. Importantly, mobility was not associated with most outcomes, lending support to set-point theory and highlighting that any mobility could correlate with tradeoffs in health and other well-being indicators. In sum, as in high-income countries, our findings reveal heterogeneity and ambiguities, and the need for a new theory that acknowledges the simultaneous gains and losses that correlate with socioeconomic mobility. © 2026 The Authors.},
	author_keywords = {Cross-cultural; Evaluative; Global South; Hedonic; Longitudinal; Slash-and-burn farming},
	keywords = {Amazonia; Bolivia; controlled substance; adult; developing world; drug user; health geography; health status; hedonic analysis; mobility; panel data; social status; addictive substance; adult; adulthood; agricultural worker; anger; Article; body mass; Bolivian; cigarette smoking; consensus development; controlled study; diet supplementation; dissociation; exploratory factor analysis; female; follow up; food industry; household economic status; human; indigenous people; major clinical study; male; material wealth; mathematical analysis; monetary reward; morbidity; nutritional assessment; panel study; psychological well-being; quantitative study; saddness; self perceived health; social mobility; socialization; temporal mobility; wealth distribution},
	correspondence_address = {R. Godoy; Heller School for Social Policy and Management, Brandeis University, Waltham, 02453, United States; email: rgodoy@brandeis.edu},
	publisher = {Elsevier Ltd},
