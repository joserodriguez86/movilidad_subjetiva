@ARTICLE{Karimi20241359,
	author = {Karimi, Aryan and Thompson, Sara and Bucerius, Sandra M},
	title = {National Assimilation and/or Cosmopolitan Transnationalism? Impending Transnationalism among the Upwardly Mobile Children of Refugees},
	year = {2024},
	journal = {Sociology},
