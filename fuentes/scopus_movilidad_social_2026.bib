	year = {2025},
	journal = {Journal of Chinese Political Science},
	volume = {30},
	number = {3},
	pages = {475 - 500},
	doi = {10.1007/s11366-024-09902-5},
	url = {https://www.scopus.com/pages/publications/85217244926?origin=resultslist},
	affiliations = {Holly Futures Co., Ltd., No. 399 Middle Jiangdong Road, Nanjing, China; School of Management and Engineering, Nanjing University, Nanjing, China; Jiangsu SOHO Holdings Group Co., Ltd, No. 48 Ruanjian Avenue, Nanjing, China},
	abstract = {China’s expanding access to higher education and economic slowdown have resulted in growing social concerns about employment opportunities for fresh graduates. This study investigates the effect of choice of major on starting wages in the Chinese labor market. Analyzing a sample of 45,000 observations from Nanjing, China, we use machine learning techniques to uncover a significant interaction between major specificity (i.e. the specificity of the knowledge and skills each major entails) and education-job relevancy in determining wages. We first take the OLS and Heckman models as the baseline, before employing the KNN and Random Forest model fits. The interaction is then measured by the adjusted Friedman’s H-index and finally visualized by network plots and thermal graphs. This research achieves three goals. First, we find that family background, measured by hukou and/or parent education, has no significant impact on major selection and university tier. This finding not only address potential endogeneity concerns, but also has important implications for the study of class mobility in contemporary China. Specifically, it indicates that the impact of the rural-urban social stratification created by the hukou policy has diminished, and that China’s higher education system facilitates social equity. Second, this is the first study to use innovative methods to examine the pricing of 206 specific majors in the Chinese labor market. Third, this research provides guidance for individuals choosing their major, governments concerned with educational resource allocation and employment opportunities, and foreign scholars with limited knowledge of China’s graduate job market. © The Author(s) 2024.},
	author_keywords = {Class mobility; Human capital; Major specificity; Starting wage},
	correspondence_address = {T. Hang; Holly Futures Co., Ltd., Nanjing, No. 399 Middle Jiangdong Road, China; email: hangt@meetsoho.cn},
	publisher = {Springer Science and Business Media B.V.},
	issn = {10806954},
	language = {English},
	abbrev_source_title = {J. Chin. Polit. Sci.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 4; All Open Access; Hybrid Gold Open Access}
}

@ARTICLE{Lin2026,
	author = {Lin, Zhiyi and Cai, Jiahe and Dong, Hongding and Yang, Haichen},
	title = {Gain by losing: Chinese elite athletes’ understanding of playing hurt and lived experience},
	year = {2026},
	journal = {International Review for the Sociology of Sport},
	pages = {},
	doi = {10.1177/10126902261428175},
	url = {https://www.scopus.com/pages/publications/105033823126?origin=resultslist},
	affiliations = {Fujian Normal University, China; Jimei University, China},
	abstract = {This study explores how Chinese athletes develop their attitudes toward playing hurt. The data for this study were gathered during 2 years of fieldwork, which comprised participant observation and semistructured interviews conducted with athletes of the F provincial teams. The findings reveal that Chinese elite athletes’ choices to play hurt are closely linked to their life experiences. These athletes channel negative life experiences into the psychological resilience and determination required to overcome injuries. Concurrently, they reframe athletic injuries and broader hardships as a catalyst for upward social mobility. We drew on Lao Tzu's philosophy of “Gain by losing (wu huo sun zhi er yi)” to frame our analysis of how loss can lead to gain within this transformative process. The philosophy of change emphasizes that injuries, like all positive and negative experiences in life, are transitory and dynamic. This study examines how socio-cultural factors and injury-related cultural norms interrelate to influence athletes’ attitudes toward playing hurt. By adopting a dialectical lens, this research contributes to non-Western frameworks for understanding injury and pain in elite sports. © The Author(s) 2026},
	author_keywords = {Chinese; class mobility; gain by losing; philosophy of change; play hurt},
	correspondence_address = {H. Yang; School of Physical Education & Sport Science, Fujian Normal University, Fuzhou, China; email: yhaichen2011@126.com},
	publisher = {SAGE Publications Ltd},
	issn = {10126902},
	language = {English},
	abbrev_source_title = {Int. Rev. Sociol. Sport},
	type = {Article},
	publication_stage = {Article in press},
	source = {Scopus},
	note = {Cited by: 0}
}

