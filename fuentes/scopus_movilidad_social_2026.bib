@ARTICLE{Wei2026,
	author = {Wei, Yehua Dennis and Xiong, Ning},
	title = {Neighborhood walkability and intergenerational mobility: Uneven associations across space and race},
	year = {2026},
	journal = {Sustainable Cities and Society},
