@ARTICLE{Iannelli2024390,
	author = {Iannelli, Cristina and Breen, Richard and Duta, Adriana},
	title = {Following in the parents' footsteps? Using sibling data to analyse the intergenerational transmission of social (dis)advantage in Scotland},
	year = {2024},
	journal = {European Sociological Review},
	volume = {40},
	number = {3},
	pages = {390 - 402},
	doi = {10.1093/esr/jcad056},
	url = {https://www.scopus.com/pages/publications/85194914938?origin=resultslist},
	affiliations = {Moray House School of Education and Sport, University of Edinburgh, St John's Land Holyrood Road, Edinburgh, EH8 8AQ, United Kingdom; Nuffield College, University of Oxford, New Road, Oxford, OX11NF, United Kingdom; Moray House School of Education and Sport, University of Edinburgh, Simon Laurie House, 186-198 Canongate, Edinburgh, EH8 8AQ, United Kingdom},
	abstract = {This study provides new evidence about the extent to which individual occupational status is determined by family of origin (ascription) and by educational attainment (achievement). Using linked administrative data from the Scottish Longitudinal Study, we measure intergenerational mobility using sibling correlations and we assess the effect of siblings' education on their occupational status by examining between- and within-sibling differences. We show that about 36 per cent of siblings' variation in occupational status in Scotland is attributable to shared family factors. Our observed measures of family background explain about 40 per cent of the shared family effect, meaning that family-based advantages in the Scottish labour market largely arise from unmeasured factors. We also find that siblings' educational attainment accounts for 80 per cent of the variation between families in occupational status. While this may suggest that the Scottish labour market is highly meritocratic, previous research that showed a very strong family effect on educational attainment leads us to a different interpretation, namely that social inequalities in education are the main mechanism through which inequalities between families are reproduced (and perhaps legitimated) in the Scottish labour market.  © 2023 The Author(s).},
	correspondence_address = {C. Iannelli; Moray House School of Education and Sport, University of Edinburgh, Edinburgh, St John's Land Holyrood Road, EH8 8AQ, United Kingdom; email: c.iannelli@ed.ac.uk},
