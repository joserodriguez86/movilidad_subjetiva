@ARTICLE{Jerrim2015505,
	author = {Jerrim, John and Macmillan, Lindsey},
	title = {Income inequality, intergenerational mobility, and the great gatsby curve: Is education the key?},
	year = {2015},
	journal = {Social Forces},
	volume = {94},
	number = {2},
	pages = {505 - 533},
	doi = {10.1093/sf/sov075},
	url = {https://www.scopus.com/pages/publications/84958662383?origin=resultslist},
	affiliations = {UCL Institute of Education, University of London, United Kingdom},
	abstract = {It is widely believed that countries with greater levels of income inequality also have lower levels of intergenerational mobility. This relationship, known as the Great Gatsby Curve (GGC), has been prominently cited by high-ranking public policymakers, bestselling authors, and Nobel Prize-winning academics. Yet, relatively little crossnational work has empirically examined the mechanisms thought to underpin the GGC-particularly with regard to the role of educational attainment. This paper uses the cross-nationally comparable Programme for International Assessment of Adult Competencies (PIAAC) data set to shed new light on this issue. We find that income inequality is associated with several key components of the intergenerational transmission process-including access to higher education, the financial returns on education, and the residual effect of parental education upon labor-market earnings. Thus, consistent with theoretical models, we find that educational attainment is an important driver of the relationship between intergenerational mobility and income inequality. We hence conclude that unequal access to financial resources plays a central role in the intergenerational transmission of advantage. © The Author 2015.},
	correspondence_address = {J. Jerrim; Department of Quantitative Social Science, Institute of Education, University of London, London, 20 Bedford Way, WC1H 0AL, United Kingdom; email: J.Jerrim@ioe.ac.uk},
	publisher = {Oxford University Press},
	issn = {00377732},
	language = {English},
	abbrev_source_title = {Soc. Forces},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 180; All Open Access; Hybrid Gold Open Access}
}

