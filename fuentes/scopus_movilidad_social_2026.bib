	volume = {16},
	number = {3},
	pages = {349 - 392},
	doi = {10.1093/jae/ejl042},
	url = {https://www.scopus.com/pages/publications/34447647692?origin=resultslist},
	affiliations = {Catholic University of Leuven, Department of Economics, Leuven, Belgium},
	abstract = {We study welfare gains and losses in a sample of 188 rural households in two Rwandan provinces over the time span 1990-2002. Our sample is unique because it covers a period of extreme and widespread violence. Using an economic mobility analysis, we seek to identify the impact of the shocks of the war, the genocide and their aftermath on long-term household welfare. To measure economic mobility between 1990 and 2002, we use both net income per adult equivalent and an asset index. We find that households experiencing the murder or imprisonment of one of their members moved considerably downwards in the income distribution. However, households affected by other war-related shocks such as the number of months taken refuge and the loss of physical capital were not worse off in 2002 compared with other households. © The author 2007. Published by Oxford University Press on behalf of the Centre for the Study of African Economies. All rights reserved.},
	keywords = {Africa; Central Africa; Rwanda; Sub-Saharan Africa; economic impact; genocide; household income; income distribution; rural economy; rural population; violence; war},
	correspondence_address = {M. Verpoorten; Catholic University of Leuven, Department of Economics, Leuven, Belgium; email: marijke.verpoorten@econ.kuleuven.be},
	issn = {14643723},
	language = {English},
	abbrev_source_title = {J. Afr. Econ.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 11}
}

