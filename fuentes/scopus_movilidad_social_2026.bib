@ARTICLE{Medici2023538,
	author = {Medici, Guri and Grote, Gudela and Igic, Ivana and Hirschi, Andreas},
	title = {Technological self-efficacy and occupational mobility intentions in the face of technological advancement: a moderated mediation model},
	year = {2023},
	journal = {European Journal of Work and Organizational Psychology},
	volume = {32},
	number = {4},
	pages = {538 - 548},
	doi = {10.1080/1359432X.2023.2197215},
	url = {https://www.scopus.com/pages/publications/85151418564?origin=resultslist},
	affiliations = {Department of Management, Technology, and Economics, ETH Zurich, Zurich, Switzerland; Military Academy at ETH Zurich, Zurich, Switzerland; Institute for Psychology, University of Bern, Bern, Switzerland; Department of Management, Deakin University, Melbourne, VIC, Australia},
	abstract = {While research on the effects of technological advancement on job design has gained traction, we know little about how personal and contextual factors relate to work attitudes and mobility intentions in relation to technology-induced change in different occupational domains. Based on social cognitive career theory, we investigated the influence of technological self-efficacy beliefs (TSE) on occupational commitment and occupational mobility intentions and included automation potential and developmental support as contextual moderators. Based on a survey study with 512 employees and two data points, we found that TSE was negatively related to occupational mobility intentions, both directly and through the mediating role of occupational commitment. The relation between occupational commitment and mobility intention was stronger for individuals receiving more developmental support. Contrary to our hypotheses, the relation between TSE and mobility intention was stronger in occupations with low and medium automation potential. Our findings provide first evidence for the relevance of TSE for occupational mobility intentions and the impact of automation potential and perceived developmental support on this relationship. We discuss the relevance of our findings for better understanding potential effects of technological advancement on occupational mobility and provide practical implications for enabling employees to deal with changing work environments. © 2023 The Author(s). Published by Informa UK Limited, trading as Taylor & Francis Group.},
	author_keywords = {automation potential; developmental support; occupational mobility; social cognitive career theory; Technological self-efficacy},
