	keywords = {Adolescent; Adult; Asymptomatic Infections; Child; Cross-Sectional Studies; Female; Humans; Malaria, Falciparum; Malaria, Vivax; Male; Multivariate Analysis; Parasitemia; Peru; Plasmodium falciparum; Plasmodium vivax; Prevalence; Seroepidemiologic Studies; Young Adult; immunoglobulin G; MSP 10 antigen; parasite antigen; recombinant antigen; unclassified drug; adolescent; adult; age distribution; Amazonas (Brazil); Article; blood sampling; child; cohort analysis; controlled study; cross-sectional study; disease carrier; enzyme linked immunosorbent assay; erythrocyte concentrate; female; geographic distribution; human; infection risk; job change; logistic regression analysis; longitudinal study; major clinical study; malaria; malaria falciparum; male; microscopy; migration; multivariate analysis; nonhuman; parasite load; parasite transmission; parasitemia; Peruvian; Plasmodium vivax malaria; polymerase chain reaction; prevalence; quantitative analysis; risk factor; asymptomatic infection; isolation and purification; malaria falciparum; parasitemia; parasitology; Peru; Plasmodium falciparum; Plasmodium vivax; Plasmodium vivax malaria; prevalence; seroepidemiology; young adult},
