	title = {Success or failure: Occupational mobility of rural return migrants in less-developed regions of China},
	year = {2026},
	journal = {Journal of Rural Studies},
	volume = {126},
	pages = {},
	doi = {10.1016/j.jrurstud.2026.104275},
	url = {https://www.scopus.com/pages/publications/105041393627?origin=resultslist},
	affiliations = {School of Geography and Tourism, Shaanxi Normal University, Shaanxi Province, Xi'an, 710119, China; The High School Park of Shenzhen Experimental School, Guangdong Province, Shenzhen, 518118, China; Institute of Natural Resources and Territorial Space / Center for Land Resources Research in Northwest China, Shaanxi Normal University, Shaanxi Province, Xi'an, 710119, China; Key Laboratory of Land Use, Ministry of Natural Resources, Beijing, 100035, China},
	abstract = {Return migration has become a prominent form of population mobility in less-developed regions of China, yet its impact on occupational mobility remains under-researched. Using original field survey data from rural counties, this study investigates whether migration experience promotes upward occupational mobility among rural return migrants and the underlying mechanisms. Results show that return migration correlates with a lower probability of upward occupational mobility in underdeveloped rural areas. Although migration experience contributes to human capital accumulation, such capital is not effectively converted into occupational advantages due to local labor market constraints and skill mismatch. More importantly, return migration weakens locally embedded social capital, which plays a key role in accessing occupational opportunities. Residing in a county seat can partly mitigate this negative effect. These findings highlight the importance of capital convertibility and local spatial embeddedness in explaining the occupational outcomes of return migrants in less-developed rural China. © 2026 Elsevier Ltd.},
	author_keywords = {Human capital; Less-developed region; Occupational mobility; Return migration; Social capital},
	keywords = {China; developing world; human capital; migrants experience; occupation; return migration; rural area; social capital},
	correspondence_address = {J. Yin; School of Geography and Tourism, Shaanxi Normal University, Xi'an, Shaanxi Province, 710119, China; email: yinjb@snnu.edu.cn},
