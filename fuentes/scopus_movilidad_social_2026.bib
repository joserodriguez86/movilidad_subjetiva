@ARTICLE{Lewycka2023,
	author = {Lewycka, Sonia and Dasgupta, Kabir and Plum, Alexander and Clark, Terryann and Hedges, Mary and Pacheco, Gail},
	title = {Determinants of ethnic differences in the uptake of child healthcare services in New Zealand: a decomposition analysis},
	year = {2023},
	journal = {International Journal for Equity in Health},
	volume = {22},
