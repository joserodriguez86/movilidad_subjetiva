	year = {2026},
	journal = {Social Networks},
	volume = {86},
	pages = {342 - 353},
	doi = {10.1016/j.socnet.2026.04.012},
	url = {https://www.scopus.com/pages/publications/105037762509?origin=resultslist},
	affiliations = {Instituto de Sociología, Pontificia Universidad Católica de Chile, Santiago, Chile; Centro de Economía y Políticas Sociales y Escuela de Gobierno y Administración Pública, Facultad de Ciencias Sociales y Artes, Universidad Mayor, Santiago, Chile; Millenium Institute for Care Research (MICARE), Santiago, Chile},
	abstract = {This study examines the socioeconomic homogeneity of acquaintance networks. Acquaintance networks, as proxies for individuals’ broader social circles, are structured by socioeconomic backgrounds and occupational stratification. We hypothesize that individuals are more likely to form ties with others in occupations of similar socioeconomic prestige. We further expect higher levels of education to be associated with greater network homogeneity, and we investigate whether intergenerational educational mobility fosters more heterogeneous networks compared to stable educational trajectories. Drawing on Aggregated Relational Data (ARD), we introduce a multilevel statistical measurement model that quantifies the number of acquaintances people have in different occupations as a function of their difference in prestige with those occupations and covariates. The model advances existing approaches by accounting for both occupational group size and respondents’ overall number of acquaintances. Using the ELSOC survey in Chile, we assess the degree of socioeconomic homogeneity in acquaintance networks among workers. Our findings show that occupationally based socioeconomic background strongly structures patterns of acquaintance, with individuals forming ties to others of similar socioeconomic status. At the same time, higher levels of education are associated with larger and more socioeconomically diverse networks, suggesting that education can mitigate these constraints. By contrast, intergenerational educational mobility plays a more limited role in shaping network heterogeneity. By showing that occupational stratification structures social ties while education can partially offset these constraints, the study contributes to broader debates on inequality, mobility, and the reproduction of social boundaries. © 2026 Published by Elsevier B.V.},
	author_keywords = {Education; Homogeneity; Multilevel Statistical Models; Occupations; Social Mobility; Socioeconomic distances},
	correspondence_address = {A. Espinosa-Rada; Instituto de Sociología, Pontificia Universidad Católica de Chile, Santiago, Chile; email: anespinosa@uc.cl},
