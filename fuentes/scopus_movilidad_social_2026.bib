@ARTICLE{Acharyya20263829,
	author = {Acharyya, Rituparna and Majumder, Arijit and Pramanick, Niloy and Mukhopadhyay, Anirban and Pramanik, Malay and Dhungana, Ganesh and Hati, Jyoti Prakash and Das, Biswanath},
	title = {A Geo-Intelligent Approach in Analysing Land Use Transformation and Socio-Economic Change (1991–2031) in a Tropical Metropolitan},
	year = {2026},
	journal = {Earth Systems and Environment},
	volume = {10},
	number = {4},
	pages = {3829 - 3848},
	doi = {10.1007/s41748-025-00798-6},
	url = {https://www.scopus.com/pages/publications/105015664571?origin=resultslist},
	affiliations = {Faculty of Geographical Sciences, Kazimierz Wielki University, Bydgoszcz, 85-064, Poland; Department of Geography, Jadavpur University, West Bengal, Kolkata, 700032, India; School of Oceanographic Studies, Jadavpur University, West Bengal, Kolkata, 700032, India; Urban Innovation and Sustainability, Asian Institute of Technology, Pathum Thani, 12120, Thailand; Disaster Preparedness, Mitigation, and Management (DPMM), Asian Institute of Technology, Pathum Thani, 12120, Thailand; Earthanalytics India Private Ltd, Vidyanagri Marg, Kali Santacruz (E), Mumbai, 400098, India},
	abstract = {Rapid urbanization and industrial development in metropolitan areas are reshaping landscapes and impacting socio-economic structures, often at the expense of environmental sustainability. Rajarhat-New Town, located in the northeastern part of Kolkata, India, is a key example of this phenomenon. The area adjacent to the Calcutta Wetlands—a Ramsar site—has undergone significant land use and land cover (LULC) changes due to rapid urbanization, affecting both environmental conditions and the socio-economic mobility of local communities. This study fills that gap by examining LULC transformations and associated socio-economic Shifts in Rajarhat-New Town from 1991 to 2021, with the goal of informing sustainable urban development policies. Using Earth Observation data and the Google Earth Engine (GEE) platform, we employ an Object-Oriented (OO) classification approach combined with machine learning techniques, specifically Random Forest (RF) and Support Vector Machine (SVM), to classify and analyze the region’s LULC. Our findings reveal that LULC changes have been predominantly negative since 1991, with agricultural land being converted into urban areas at an accelerated rate. A multi-temporal analysis of LULC patterns conducted at 10-year intervals indicates significant Shifts, particularly in the transition from agriculture to built-up areas, which aligns with population growth and socio-economic Shifts. Aquaculture expanded to cover 17.54% of the area by 2011 but declined by 2.32% by 2021 due to rapid urbanization. The study further predicts LULC changes for 2031, indicating continued urban growth, especially toward the southern part of the study area, with a further decline in open land, scrubland, and aquaculture areas. A projection of LULC for 2031 further highlights the continued urban expansion in the region. These findings highlight the urgent need for integrated land-use planning that balances urban growth with environmental conservation. We recommend targeted policy measures promoting sustainable land management, urban resilience, and socio-economic inclusivity to ensure the long-term sustainability of Rajarhat-New Town. © King Abdulaziz University and Springer Nature Switzerland AG 2025.},
	author_keywords = {LULC; Object-oriented classification; Rajarhat-New town; Urban expansion; Urban sustainability},
	keywords = {India; artificial intelligence; image classification; land use change; metropolitan area; socioeconomic status; sustainability; urban policy; urbanization},
	correspondence_address = {M. Pramanik; Urban Innovation and Sustainability, Asian Institute of Technology, Pathum Thani, 12120, Thailand; email: malay@ait.asia},
	publisher = {Springer Science and Business Media Deutschland GmbH},
	issn = {25099426},
	language = {English},
	abbrev_source_title = {Earth Sys. Environ.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 3}
}

