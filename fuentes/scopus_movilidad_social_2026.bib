	year = {2025},
	journal = {International Journal of Educational Development},
	volume = {117},
	pages = {},
	doi = {10.1016/j.ijedudev.2025.103337},
	url = {https://www.scopus.com/pages/publications/105008207744?origin=resultslist},
	affiliations = {University of Bristol, United Kingdom; Centre of African Studies, University of Edinburgh, United Kingdom; University of the Free State, South Africa},
	abstract = {Despite extensive scholarship demonstrating that education alone cannot achieve systemic change without broader social and economic reforms, international development agencies and policymakers continue to present it as a panacea for poverty reduction, gender equality, and economic mobility. This paper strengthens critiques of education's positioning as a primary driver of social transformation in development discourse by revealing how such framings neglect both the structural conditions that constrain education's impact and the complex relationships between education, power, and inequality. Through empirical research from Cameroon and Ghana, the authors demonstrate how education not only fails to fulfil its promised empowerment of women and people with disabilities but can actually reinforce their marginalisation. The paper distinguishes itself from conventional critiques that focus primarily on education quality issues by applying African-feminist perspectives to challenge the fundamental neoliberal assumptions that emphasise individual empowerment while ignoring systemic forces of social reproduction. By integrating insights from social reproduction theory and African-feminist thought, the authors establish that even high-quality education cannot guarantee social change given the deep-rooted influences of colonial histories and neocolonial presents. This work advances critical debates on education and development by advocating for decolonial frameworks that provide more nuanced, contextually grounded, and decolonial approaches to understanding education's role in social transformation. © 2025},
	author_keywords = {African feminisms; Disability; Education; Gender; Social change; Social reproduction},
	keywords = {Africa; Cameroon; Ghana; advocacy; disability; economic reform; education; educational development; empowerment; feminism; gender relations; gender role; marginalization; poverty alleviation; social change},
	correspondence_address = {M. Kwachou; University of Bristol, United Kingdom; email: monique.kwachoutangah@bristol.ac.uk},
	publisher = {Elsevier Ltd},
	issn = {07380593},
	language = {English},
	abbrev_source_title = {Int. J. Educ. Dev.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 1; All Open Access; Green Open Access; Hybrid Gold Open Access}
}

@ARTICLE{Yoon2026,
	author = {Yoon, Soohyun and Schneider, William J.},
	title = {Downward identification and parental endorsement of spanking: Evidence from mobility-based status inconsistency},
	year = {2026},
	journal = {Child Abuse and Neglect},
	volume = {181},
	pages = {},
	doi = {10.1016/j.chiabu.2026.108324},
	url = {https://www.scopus.com/pages/publications/105050608057?origin=resultslist},
	affiliations = {School of Social Work, University of Illinois Urbana–Champaign, Urbana, IL, United States},
	abstract = {Background: Child maltreatment research has established socioeconomic disadvantage as a robust risk factor, yet socioeconomic status (SES) is almost universally treated as a static attribute. Whether the dynamic, generational dimensions of economic experience, including intergenerational mobility trajectories and the class identities individuals construct around them, are independently associated with parental endorsement of spanking remains underexplored. Objective: To examine whether intergenerational occupational mobility trajectories and mobility-based status inconsistency independently predict parental endorsement of spanking, and whether this association differs by direction of identification. Participants and setting: Pooled General Social Survey data (N = 9178; waves 1986–2016), a nationally representative repeated cross-sectional survey of U.S. adults. Methods: Intergenerational mobility trajectories were constructed using SEI-10 occupational prestige scores. Mobility-based status inconsistency was defined as the residual discrepancy between subjective class identification and objective mobility trajectory. Parental endorsement of spanking was measured with a single survey item. Sequential logistic regression models estimated associations after adjusting for parenting attitudes, education, income, and sociodemographic covariates, with a formal Wald test directional symmetry. Results: Mobility-based status inconsistency was independently associated with spanking endorsement in the fully adjusted model (b = −0.125, p = .005). Mobility trajectory alone carried no independent association. Decomposition analyses showed that downward identification was associated with higher spanking endorsement (b = 0.201, p = .025), while upward identification was not (b = −0.034, p = .743); a formal test of directional symmetry did not reject symmetry (χ<sup>2</sup>(1) = 0.95, p = .330). Conclusions: Mobility-based status inconsistency, and downward class identification in particular, is associated with parental endorsement of spanking independently of current SES, parenting attitudes, and sociodemographic background, pointing to subjective and generational dimensions of economic experience that static SES measures do not fully capture. © 2026 The Authors},
	author_keywords = {Child maltreatment; Intergenerational mobility; Parenting; Socioeconomic status; Spanking; Status inconsistency},
	keywords = {adult; article; child abuse; child parent relation; cross-sectional study; decomposition; female; human; major clinical study; male; risk factor; social status},
