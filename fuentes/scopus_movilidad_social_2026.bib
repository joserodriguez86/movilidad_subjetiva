	doi = {10.1007/s40615-025-02738-6},
	url = {https://www.scopus.com/pages/publications/105026675857?origin=resultslist},
	affiliations = {Department of Africana Studies, University of Maryland, Baltimore County, Catonsville, MD, United States; Department of Kinesiology, Health Promotion, and Recreation, University of North Texas, Denton, TX, United States; Institute for Health and Humanity, Medical College of Wisconsin, Milwaukee, WI, United States; Nourish, Oklahoma City, OK, United States; Program for Research on Men’s Health, Johns Hopkins Center for Health Disparities Solution, Johns Hopkins Bloomberg School of Public Health, Johns Hopkins University, Baltimore, MD, United States; Department of Psychiatry, University of Texas Southwestern Medical Center, Dallas, TX, United States},
	abstract = {Black American men in the United States face a disproportionate burden of obesity-related morbidity and mortality, which contributes to lower life expectancy. Although national guidelines suggest that physical activity regardless of domain can reduce obesity risk, emerging research on the “physical activity paradox” questions whether occupational physical activity (OPA) confers the same health benefits as leisure-time physical activity (LTPA). This paradox is especially relevant to Black American men, who are overrepresented in physically demanding jobs due to structural racism and limited occupational mobility. Yet, the impact of domain-specific physical activity on obesity outcomes among this population remains understudied. This study uses six waves (2007–2018) of the National Health and Nutrition Examination Survey (NHANES) to analyze the association between domain-specific physical activity (OPA vs. LTPA) and body mass index (BMI) in a nationally representative sample of Black American men aged 18 and older. Participants who reported implausible levels of activity were excluded. Multivariable regression analyses were conducted to test whether LTPA or OPA predicted BMI. Findings reveal that higher levels of LTPA are significantly associated with lower BMI, whereas higher levels of OPA are not. These results support the physical activity paradox and highlight the pressing need for culturally informed public health messaging and workplace policies that differentiate between types of physical activity. Addressing the paradox among Black American men may help reframe obesity prevention strategies and reduce disparities stemming from systemic inequities in labor and health. © W. Montague Cobb-NMA Health Institute 2026.},
	author_keywords = {Allostatic load; Black American men; Body mass index (BMI); Leisure-time physical activity (LTPA); Obesity; Occupational physical activity (OPA); Physical activity paradox},
