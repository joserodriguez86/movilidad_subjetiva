	pages = {115 - 127},
	doi = {10.20069/j.cnki.DJKX.202305009},
	url = {https://www.scopus.com/pages/publications/85190684887?origin=resultslist},
	affiliations = {School of Public Finance and Taxation, Southwestern University of Finance and Economics, Chengdu, 611130, China; School of Economics, Sichuan University, Chengdu, 610065, China},
	abstract = {Higher education plays a vital role in upward mobility for the general class, but concerns have arisen regarding "diploma devaluation" and "college student ants" due to the rapid growth of college enrollment. Understanding whether and how higher education facilitates income class mobility for individuals has become increasingly important. While existing literature examines higher education's impact on social class mobility and intergenerational income mobility, limited studies explore the relationship between higher education and intragenerational income class mobility, particularly considering individual-level data and diverse institutional factors such as marriage choice and population mobility. This paper utilizes data from the China Family Panel Studies (CFPS) spanning from 2010 to 2020 to analyze individual income class mobility. We employ a cohort difference-in-difference model, leveraging the 'College Enrollment Expansion' policy as a quasi-natural experiment to assess the impact of higher education on individual income mobility. Empirical results reveal that higher education expansion enhances individual income class mobility and promotes income stratum spanning. A comparison between rural and urban areas demonstrates that higher education expansion significantly affects both absolute and relative mobility of rural individuals' incomes, whereas only absolute mobility of urban individuals' incomes is affected significantly. Mechanism tests indicate that the expansion of higher education increases the likelihood of educated individuals entering human capital-intensive industries, and it influences individual income class mobility through marriage choices and cross-regional mobility. Compared to the previous literature, there are three main possible marginal contributions: First, we analyze the impact of higher education expansion on intra-generational income class mobility at the individual level and explore its pathways, including industry choice, marriage mechanisms, and population migration. Second, it is a comprehensive measure of individual income mobility in terms of both absolute and relative mobility, and uses the data of CFPS to match individuals in different years, reflecting the continuous changes of individual income class mobility in continuous time, which can reflect the absolute and relative changes in income in a more comprehensive and dynamic manner. Third, we employ a cohort difference-in-difference model and use the "College Enrollment Expansion"policy as a quasi-natural experiment, providing insights into the relationship and potential mechanisms between higher education and individual income class mobility in China. This study investigates whether higher education expansion in China promotes upward income mobility for individuals and elucidates the underlying channels. Theoretical implications include a clearer understanding of the relationship and mechanisms between higher education and income mobility, thereby enhancing the theoretical foundation for education's role in class mobility. In reality, it can provide a useful reference for further education reform. © 2023 Editorial Board of Modern Economic Science. All rights reserved.},
	author_keywords = {class solidification; college expansion; higher education; income mobility; individual income},
	correspondence_address = {X. Tu; School of Public Finance and Taxation, Southwestern University of Finance and Economics, Chengdu, 611130, China; email: tuxunhua@smail.swufe.edu.cn},
	publisher = {Editorial Board of Modern Economic Science},
	issn = {10022848},
	language = {Chinese},
	abbrev_source_title = {Mod. Econ. Sci.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@ARTICLE{Korotaev202371,
	author = {Korotaev, Sergey A. and Gasiukova, Elena N.},
