}

@ARTICLE{Du20223357,
	author = {Du, Jie and Zhang, Yu-Hui and Zhang, Wen and Cao, Xiao-Hua and Lin, Jun-Chang},
	title = {Analysis on the status and influencing factors of family doctor service signing among floating population in China; [我国流动人门家庭医生服务签约现状及影响因素分析]},
	year = {2022},
	journal = {Modern Preventive Medicine},
	volume = {49},
	number = {18},
	pages = {3357 - 3362and3383},
	doi = {10.20043/j.cnki.MPM.202202088},
	url = {https://www.scopus.com/pages/publications/85168390036?origin=resultslist},
	affiliations = {School of Public Health, Weifang Medical University, Shandong, Weifang, 261053, China},
	abstract = {Objective To understand the status and influencing factors of family doctor service signing among floating population in China, improve the equalization level of basic medical and health services for floating population, and protect and maintain the health of floating population. Methods The data of 138 955 floating population from May to August 2018 were collected using SPSS25.0 statistical software. The main analysis methods were statistical description, X<sup>2</sup> test, and binary logistic regression. Results The signing rate of floating population's family doctors was 12.3%. Shanxi Province had the highest signing rate of floating population's family doctors (48.6%) and Shanghai had the lowest signing rate (1.6%). Binary logistic regression analysis showed that people having a spouse (OR=1.284, 95%CI: 1.202-1.372), floating duration of 6 to 9 years (OR=1.090, 95%CI: 1.029-1.154), inflow into the central region (OR=1.133, 95%CI: 1.080-1.189), social mobility (OR=1.002, 95%CI: 0.984-1.197), household monthly income less than 3 000 yuan (OR=1.497, 95%CI: 1.391-1.611), self-rated health (OR=1.092, 95%CI: 1.023-1.165), having established health records (OR=38.932, 95%CI: 36.788-41.201), and having received health education (OR =2.488, 95%CI: 2.290-2.702) had higher signing rate, but those aged 15 to 24 years old (OR=0.718, 95%CI: 0.619-0.832), high school and below (OR=0.833, 95%CI: 0.766-0.907), inter-provincial migration (OR=0.825, 95%CI: 0.782-0.871), production and transportation workers (OR=0.868, 95%CI: 0.818-0.921) had low signing rate. Conclusion Currently, the implementation of family doctor contracting services for the mobile population is not satisfactory, and age, education level, marital status, mobility time, and mobility range are the influencing factors for whether to sign up for family doctor services. © 2022 Editorial Office of Modern Preventive Medicine. All rights reserved.},
	author_keywords = {Family doctor contract service; Floating population; Influencing factor},
	publisher = {Editorial Office of Modern Preventive Medicine},
	issn = {10038507},
	language = {Chinese},
	abbrev_source_title = {Mod. Prev. Med.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 7}
}

@ARTICLE{Ulvestad20231005,
	author = {Ulvestad, Marte E. S. and Markussen, Simen},
	title = {Born or bred? The roles of nature and nurture for intergenerational persistence in labour market outcomes},
	year = {2023},
	journal = {Journal of Population Economics},
	volume = {36},
	number = {2},
	pages = {1005 - 1047},
	doi = {10.1007/s00148-021-00880-z},
	url = {https://www.scopus.com/pages/publications/85123107806?origin=resultslist},
	affiliations = {Nordic Institute for Studies in Innovation, Research and Education, Oslo, Norway; Ragnar Frisch Centre for Economic Research, Oslo, Norway},
	abstract = {Using a Norwegian sample of adoptees from South Korea, matched to a sample of Norwegian-born children, we study the intergenerational transmission of labour market outcomes, including earnings, disability insurance participation and sickness absence, as well as education. We find the nurture effect to be substantial for education, labour earnings, and sickness absence, but fairly small and insignificant for disability insurance participation. By carefully comparing adoptees to children living with their biological parents, we also estimate the shares of intergenerational transmission stemming from heritability and environmental factors. Across outcomes we find heritability to account for about 50–100% of intergenerational transmission. © 2021, The Author(s), under exclusive licence to Springer-Verlag GmbH Germany, part of Springer Nature.},
	author_keywords = {Adoptees; Heritability; Intergenerational mobility; Intergenerational transmission; Sickness benefits},
	correspondence_address = {S. Markussen; Ragnar Frisch Centre for Economic Research, Oslo, Norway; email: simen.markussen@frisch.uio.no},
	publisher = {Springer Science and Business Media Deutschland GmbH},
	issn = {09331433},
	language = {English},
	abbrev_source_title = {J. Popul. Econ.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 1}
}

@ARTICLE{Poulson2023312,
	author = {Poulson, Michael R. and Neufeld, Miriam Y. and Laraja, Alexander and Allee, Lisa and Kenzik, Kelly M. and Dechert, Tracey},
	title = {Historic redlining, social mobility, and firearm violence},
	year = {2023},
	journal = {Journal of Trauma and Acute Care Surgery},
	volume = {94},
	number = {2},
	pages = {312 - 319},
	doi = {10.1097/TA.0000000000003757},
	url = {https://www.scopus.com/pages/publications/85147029839?origin=resultslist},
	affiliations = {Department of Surgery, Boston Medical Center, Boston University School of Medicine, Boston, MA, United States; Institute for Cancer Outcomes and Survivorship, University of Alabama Ͽ Birmingham, Birmingham, AL, United States},
	abstract = {BACKGROUND Much of the recorded medical literature focuses on individual-level factors that contribute to firearm violence. Recently, studies have highlighted higher incidence of firearm violence in historically redlined and marginalized areas, but few have gone on to study the downstream associations causing these differences. This study aims to understand the effects of historic redlining and current income mobility on firearm violence. METHODS Using a retrospective cross-sectional design, shooting incidents were spatially joined with redlining vector files and linked to income mobility data (how much a child makes in adulthood). Participants included all assault and homicide incidents involving a firearm in the city of Boston, between 2016 and 2019. The exposure of interest was redlining designation as outlined by the Home Owner's Loan Corporation (HOLC) in the 1930s and income mobility, stratified by race, defined as the income of a child in their 30s compared with where they grew up (census tract level). The outcome measured was shooting rate per census block. RESULTS We find that increases in Black income mobility (BIM) and White income mobility (WIM) are associated with significant decreases in rates of firearm incidents in all HOLC designations; however, there is a larger decrease with increasing BIM (relative risk, 0.47 per unit increase in BIM [95% confidence interval, 0.35-0.64]; relative risk, 0.81 per unit increase in WIM [95% confidence interval, 0.71-0.93]). Plotting predicted rates of firearm violence in each HOLC designation at different levels of BIM, there were no significant differences in shooting rates between historically harmful and beneficial classifications above $50,000 of BIM. Despite level of WIM, there were continued disparities between harmful and beneficial HOLC classification. CONCLUSION These findings highlight the importance of structural racism in the form of redlining and discriminatory housing policies, and the preclusion from economic mobility therein, on the incidence of firearm violence today. LEVEL OF EVIDENCE Prognostic and Epidemiological; Level IV.  © Wolters Kluwer Health, Inc. All rights reserved.},
	author_keywords = {firearm violence; Income mobility; racism; redlining},
	keywords = {Child; Cross-Sectional Studies; Firearms; Humans; Retrospective Studies; Social Mobility; Violence; adult; adulthood; article; assault; census tract; child; cross-sectional study; female; gun violence; homicide; housing; human; incidence; male; Massachusetts; outcome assessment; retrospective study; risk factor; social class; social segregation; structural racism; firearm; violence},
	correspondence_address = {T. Dechert; Department of Surgery, Boston Medical Center, Boston University School of Medicine, Boston, 850 Harrison Ave, 02118, United States; email: Tracey.Dechert@bmc.org},
	publisher = {Lippincott Williams and Wilkins},
	issn = {21630755},
	pmid = {35939375},
	language = {English},
	abbrev_source_title = {J. Trauma Acute Care Surg.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 22}
}

