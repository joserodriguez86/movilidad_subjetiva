	pages = {},
	doi = {10.1016/j.scs.2026.107537},
	url = {https://www.scopus.com/pages/publications/105040648791?origin=resultslist},
	affiliations = {School of Environment, Society and Sustainability, University of Utah, Salt Lake City, 84112, UT, United States},
	abstract = {Intergenerational mobility (IM) has declined in the United States (U.S.), exacerbating socioeconomic and racial inequalities. Walkability, a key built environment attribute, remains an underexamined driver of opportunity by shaping access to health-promoting resources and social networks. This study provides one of the first nationwide, tract-level analyses linking walkability to long-term IM outcomes across 71,410 U.S. census tracts and how these relationships are moderated by socioeconomic status (SES) and vary by race, revealing heterogeneity obscured in aggregate analyses. We find that the association between walkability and IM is uneven across SES levels and race: walkability is positively associated with IM for White populations but negatively associated with IM for Black populations, reflecting persistent structural inequalities. As SES increases, the positive association for White populations strengthens, while the negative association for Black populations attenuates. Moreover, walkability-IM relationships for both groups are more strongly moderated by the SES of Black residents than by that of White residents within the same neighborhoods. Sensitivity analyses using spatial error models show that these racially differentiated patterns remain robust after accounting for spatial autocorrelation. Overall, the findings suggest that walkability can widen or narrow inequality depending on local SES contexts, underscoring the built environment as a powerful yet underutilized lever for promoting IM. Equity-oriented, place-based planning and policy that enhance walkability in disadvantaged neighborhoods while addressing structural barriers facing Black communities are critical to reverse declines in IM and reducing racial and spatial disparities, thereby fostering more inclusive and sustainable communities. © 2026 Elsevier Ltd},
	author_keywords = {Intergenerational mobility; Neighborhood effects; Neighborhood walkability; Racial disparities; Socioeconomic status},
	keywords = {United States; Autocorrelation; Economics; Sustainable development; Built environment; Census tracts; Intergenerational mobility; Neighborhood effect; Neighborhood walkability; Neighbourhood; Racial disparity; Socio-economic status; Socio-economics; mobility; neighborhood; race; socioeconomic conditions; socioeconomic status; sustainable development; Sensitivity analysis},
