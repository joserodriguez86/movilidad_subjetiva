@ARTICLE{Shahbazian2022527,
	author = {Shahbazian, Roujman and Bihagen, Erik},
	title = {Does Your Class Give More than a Hint of Your Lifetime Earnings?: Assessing Indicators for Lifetime Earnings Over the Life Course for Sweden},
	year = {2022},
	journal = {European Sociological Review},
