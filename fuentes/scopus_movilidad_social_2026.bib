	url = {https://www.scopus.com/pages/publications/105041640702?origin=resultslist},
	affiliations = {College of State Governance, Southwest University, No. 2 Tiansheng Road, Beibei District, Chongqing, 400715, China; School of Public Administration, Shanghai University of Finance and Economics, No. 777 Guoding Road, Yangpu District, Shanghai, 200433, China; School of Finance, Shanghai University of Finance and Economics, No.777 Guoding Road, Yangpu District, Shanghai, China},
	abstract = {A key challenge in reducing rural relative poverty is ensuring that public transfers reach disadvantaged households, as information frictions and local capture often distort their allocation. Using three waves of nationally representative household data from the Chinese Thousand Villages Survey between 2017 and 2023, this paper estimates whether digital governance platforms embedded in rural administration mitigate these distortions and reduce relative poverty. The results show that digital platforms are associated with a significant reduction in relative poverty. Mechanism analysis indicates that platforms improve policy awareness, facilitate participation in transfer programs, and reduce the influence of local elites, thus enhancing both the efficiency and fairness of redistribution. However, the benefits are not evenly distributed: effectiveness varies with local administrative capacity, and vulnerable households often face barriers to participation. Although platforms improve the precision of transfer targeting, their contribution to long-term income mobility and inequality reduction remains limited. By shifting attention from market-based digital tools to governance platforms embedded in village administration and from absolute to relative poverty, this study provides new evidence on the redistributive role of digital technologies in developing-country contexts. Copyright © 2026. Published by Elsevier Ltd.},
