	url = {https://www.scopus.com/pages/publications/105047404031?origin=resultslist},
	affiliations = {Faculty of Engineering, Universitas Indonesia, West Java, Depok, Indonesia; Department of Architecture, Research Center for Housing and Policy, Universitas Indonesia, West Java, Depok, Indonesia},
	abstract = {This study explores the intersection between commuting patterns, income levels, and housing preferences within Jakarta’s metropolitan context to reinterpret the concept of Unitary Urbanism as a framework for inclusive housing integration. The research uses a quantitative approach through a questionnaire involving 450 respondents aged 20 to 39, supported by stratified random sampling. Findings reveal that private-sector employees dominate the urban workforce (50.2%), with 57% commuting across municipal boundaries, reflecting the persistent spatial mismatch between residential and employment zones. Conversely, civil servants and state-owned enterprise employees exhibit shorter commuting times and spatial proximity to their workplaces, signifying locational stability. Housing preferences are strongly mediated by income: middle-income groups (IDR 5–15 million) demonstrate sensitivity to affordability and proximity to mass transit, while high-income individuals gravitate toward central districts with premium amenities. Respondents overwhelmingly expressed optimism toward integrated vertical housing—particularly two-bedroom units atop public facilities—highlighting the significance of accessibility, spatial adequacy, and social inclusion. The study contextualizes these empirical patterns through spatial preference mapping and commuter narrative cartography, visualizing how income, mobility, and housing choices coalesce into a lived expression of Unitary Urbanism in Jakarta’s complex urban fabric. The findings conclude that reimagining public housing within transport-oriented and multifunctional public infrastructures can bridge the conceptual divide between the ideals of Unitary Urbanism and Indonesia’s fragmented urban realities, promoting affordable, equitable, and socially cohesive metropolitan living. © 2026, Common Ground Research Networks. All rights reserved.},
	author_keywords = {Housing atop Public Infrastructure; Housing Urbanism; Inclusive Planning; Public Housing},
