@ARTICLE{Nunez Collado20252275,
	author = {Nunez Collado, José Rafael},
	title = {From ‘poor devil’ to middle class? Navigating resettlement and (in)formal reterritorialisation under COVID-19},
	year = {2025},
	journal = {Urban Studies},
	volume = {62},
	number = {11},
	pages = {2275 - 2292},
