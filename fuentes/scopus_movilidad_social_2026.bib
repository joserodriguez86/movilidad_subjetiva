@ARTICLE{Kihara2022463,
	author = {Kihara, Tate},
	title = {The Life Course Origins of the Immigrant Advantage? Parental Nativity, Parental Education, and Academic Achievement Gaps From Kindergarten to High School in the United States},
	year = {2022},
	journal = {International Migration Review},
	volume = {56},
