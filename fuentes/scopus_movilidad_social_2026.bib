@ARTICLE{Dearden199747,
	author = {Dearden, Lorraine and Machin, Stephen and Reed, Howard},
	title = {Intergenerational mobility in Britain},
	year = {1997},
	journal = {Economic Journal},
	volume = {107},
	number = {440},
	pages = {47 - 66},
	doi = {10.1111/1468-0297.00141},
	url = {https://www.scopus.com/pages/publications/0030857547?origin=resultslist},
	abstract = {We use longitudinal data on children and their parents to assess the extent of intergenerational mobility in Britain. Based on data from the National Child Development Survey, a cohort of all individuals born in a week of March 1958, we find that the extent of intergenerational mobility is limited. We report a clear intergenerational correlation between fathers and both sons and daughters in terms of labour market earnings and years of schooling. We also reveal an important asymmetry in intergenerational earnings mobility, with upward mobility from the bottom of the earnings distribution being more likely than downward mobility from the top. © Royal Economic Society 1997.},
