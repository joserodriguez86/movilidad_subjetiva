@ARTICLE{Wassink20181069,
	author = {Wassink, Joshua Thomas and Hagan, Jaqueline Maria},
	title = {A dynamic model of self-employment and socioeconomic mobility among return migrants: The case of urban Mexico},
	year = {2018},
	journal = {Social Forces},
	volume = {96},
