	title = {Automation and occupational mobility: A task and knowledge-based approach},
	year = {2022},
	journal = {Technology in Society},
	volume = {70},
	pages = {},
	doi = {10.1016/j.techsoc.2022.101976},
	url = {https://www.scopus.com/pages/publications/85129951726?origin=resultslist},
	affiliations = {ISM University of Management and Economics, Arklių str. 18, Vilnius, LT-01305, Lithuania},
	abstract = {How does automation affect labour? Academic literature emphasises that automation leads to job displacement, polarisation of labour, slower wage growth for the middle skilled and more. However, existing literature seldom discusses ways individuals could adapt to automation. One such insufficiently explored adaptation strategy is occupational mobility. To fill this gap, this article proposes and validates a task and knowledge based occupational mobility network that takes into account automation. The result of the analysis shows that many compelling insights can be derived from such a network. First, many occupations cluster together with similar automation probabilities, though some exceptions exist. Second, individuals from occupations who share tasks with occupations that have a low probability of automation can more easily find a new job if they lose their current one. Finally, the analysis shows that occupational mobility could greatly enrich the discussion on automation and labour. © 2022 Elsevier Ltd},
	author_keywords = {Automation; Labour force; Network analysis; Occupational mobility; Tasks},
	keywords = {Employment; Knowledge based systems; Academic literature; Adaptation strategies; Job displacement; Knowledge based; Knowledge-based approach; Labor force; Mobility networks; Task; Task based approach; Task-based; adaptation; automation; labor; network analysis; probability; wage; Automation},
	publisher = {Elsevier Ltd},
	issn = {0160791X},
	language = {English},
	abbrev_source_title = {Technol. Soc.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 14}
}

