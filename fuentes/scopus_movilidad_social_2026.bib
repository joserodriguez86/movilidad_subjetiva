@ARTICLE{Welsh Carroll202524,
	author = {Welsh Carroll, Megan and O’Donnell, Rebekah and Rios, Adriana and Kodituwakku, Lahiru and Zampa, Giovanna and Swayne, Madison RE and Felner, Jennifer K and Calzo, Jerel P},
	title = {There is no place to go in “America's Finest City”: Basic sanitation deprivation is punishment in San Diego, California, USA},
	year = {2025},
	journal = {Punishment and Society},
	volume = {27},
	number = {1},
