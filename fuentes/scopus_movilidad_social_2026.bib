	pages = {},
	doi = {10.1007/s10611-025-10240-7},
	url = {https://www.scopus.com/pages/publications/105024208180?origin=resultslist},
	affiliations = {School of Social Work and Criminology, Université Laval, 1030, Avenue Des Sciences-Humaines, office 6411, Québec, G1V 0A6, Canada; Simon Fraser University, BC, Canada; Service de Police de la Ville de Montréal, Montréal, Canada; School of Criminology, Université de Montréal, Montréal, Canada},
	abstract = {Most gang research explains why youth enter or exit gangs, but far less is known about what happens once they are inside. In particular, little is known about how members ascend to positions of status within gangs. We address this gap by examining whether and how members’ social ties, including their structural positions within the gang network, shape status attainment. Using detailed police data on 943 established street gang members tracked over nearly two decades, we test whether differences in members’ network positions explain differences in their individual performance as entrepreneurs, core members, and street combatants. We find that brokerage positioning–connecting otherwise unconnected gang affiliates–emerges as a common correlate of individual performance among gang members. However, the search for suitable partners is goal specific: affiliates seeking entrepreneurial status do not require the same kinds of social resources as those pursuing other forms of status within the gang. We conclude that affiliates must find suitable partners in crime, aligned with their talents and aspirations, to join the few elites of the street gang world. © The Author(s), under exclusive licence to Springer Nature B.V. 2025.},
	author_keywords = {Criminal achievement; Network analysis; Social capital; Street gangs},
