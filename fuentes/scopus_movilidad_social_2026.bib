@ARTICLE{Hollister2009235,
	author = {Hollister, Matissa},
	title = {Is optimal matching suboptimal?},
	year = {2009},
	journal = {Sociological Methods and Research},
	volume = {38},
	number = {2},
	pages = {235 - 264},
	doi = {10.1177/0049124109346164},
