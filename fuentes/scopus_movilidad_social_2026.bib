	abbrev_source_title = {Z. Psychosom. Med. Psychother.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 9}
}

@ARTICLE{Titma2007102,
	author = {Titma, Mikk and Tuma, Nancy Brandon and Roots, Ave},
	title = {Adolescent agency and adult economic success in a transitional society},
	year = {2007},
	journal = {International Journal of Psychology},
	volume = {42},
	number = {2},
	pages = {102 - 109},
	doi = {10.1080/00207590600991294},
	url = {https://www.scopus.com/pages/publications/33947231155?origin=resultslist},
	affiliations = {Stanford University, CA, United States; Tartu University, Estonia; Sociology Department, Stanford University, Stanford, CA 94305-2047, United States},
	abstract = {Following our previous research, we argue that weak societal institutions allow human agency factors to influence human behaviour strongly and, in particular, to affect how people coped with the collapse of Soviet institutions and responded to new opportunities that arose in the transition from communism. We chose Estonia as our study site because it had a "bottom-up" transition that encouraged individual initiative and mass participation. Further, its state rapidly developed efficient, democratic institutions and legalized private ownership, which reorganized economic activity. Human agency factors include pre-conditions (e.g., skills, education, goals), processes (e.g., making choices and factors affecting choices, such as self-efficacy and locus of control), and previous agentic actions. We examined the impacts of adolescent abilities and goals, completed education, and economic activities in the first stage of the transition on economic success in the second stage using longitudinal data from the Paths of a Generation study. Respondents were interviewed around age 18 (in 1983) and again around ages 23 (in 1988), 28 (in 1993), 32 (in 1997), and 39 (in 2004). As hypothesized, we found evidence that adolescentsé abilities affected both income in 2004 and income mobility between 1997 and 2004. Additional education completed after adolescence and economic activities reflecting individual initiative in the first stage of the transition also promoted economic success. Surprisingly, adolescent agency had noteworthy effects on the economic success of adults who were almost 40 years old and who had been reared and educated in a communist society with strikingly different institutions, norms, and values than those in Estonia in 2004. Suite à notre recherche passée, nous argumentons que des institutions sociétales faibles permettent à léaction humaine de fortement influencer le comportement humain et, particulièrement, déaffecter comment les gens ont composé avec le démantélement des institutions soviétiques et ont répondu aux nouvelles opportunités qui ont émergé dans la transition du communisme. Nous avons choisi léEstonie comme site de notre étude parce quéil a une transition bottom-up, dite ascendante ou de bas en haut, qui encourage léinitiative individuelle et la participation populaire. De plus, son état a rapidement développé des institutions efficaces, démocratiques et a légalisé la propriété privée, ce qui a réorganisé léactivité économique. Les facteurs impliqués dans léaction humaine incluent des pré-conditions (e.g., habiletés, éducation, buts), des processus (e.g., faire des choix et facteurs affectant les choix, comme léauto-efficacité et le locus de contrǒle) et les actions volontaires passées. Nous avons examiné les impacts des habilités et des buts, de lééducation complé tée et des activités économiques des adolescents dans la première étape de la transition sur le succès économique dans la deuxième étape en utilisant des données longitudinales de léétude Sillons (Trajectoires) déune Génération («Paths of a Generatione«). Les répondants ont été interviewés à léǎge de 18 ans approximativement (en 1983) et de nouveau aux alentours des ǎges de 23 (en 1988), 32 (en 1997) et 39 (en 2004) ans. Tel que nous avons prédit, nous avons trouvé évidence que les habiletés des adolescents ont affecté à la fois le revenu en 2004 et la mobilité du revenu entre 1997 et 2004. Une éducation additionnelle complétée après léadolescence et des activités économiques reflétant léinitiative individuelle à la premire tape de la transition ont aussi fait la promotion du succs conomique. De manire surprenante, léaction des adolescents a eu des effets qui mritent détre souligns sur le succs conomique des adultes qui taient gs de presque 40 ans et qui ont t levs dans une communaut communiste avec des institutions, des normes et des valeurs tonnamment diffrentes de celles en Estonie en 2004. De acuerdo con nuestras investigaciones anteriores, alegamos que las instituciones sociales dbiles permiten que los factores de manejo de los propios recursos, o de agencia humana, influyan fuertemente sobre la conducta humana y, en particular, afectan la forma en que la gente afront el colapso de las instituciones soviticas y respondi a las nuevas oportunidades que surgieron en la transicin del comunismo. Seleccionamos Estonia como sitio de estudio porque tuvo una transicin desde cero que promovi la iniciativa individual y la participacin en masa. Es ms, su estado desarroll rpidamente instituciones eficientes y democrticas, y legaliz la propiedad privada, lo que reorganiz la actividad econmica. El factor de agencia humana incluye precondiciones (por ejemplo, habilidades, educacin, metas), procesos (por ejemplo, elegir y cambiar los factores que afectan esas elecciones, tales como autoeficacia y locus de control), y acciones de agencia previas. Examinamos el impacto de las habilidades y metas, educacin terminada, y actividades econmicas de los adolescentes, en la primera etapa de la transicin sobre el xito econmico en la segunda etapa, mediante datos longitudinales del estudio Senderos de una Generacin. Se entrevist a los participantes aproximadamente a los 18 aos (en 1983) y nuevamente cerca de los 23 (en 1988), a los 28 (en 1993), a los 32 (en 1997), y a los 39 (en 2004). Tal como se haba postulado, se encontr que las habilidades de los adolescentes afectaban tanto el ingreso en 2004 y la movilidad del ingreso entre 1997 y 2004. La escolaridad terminada posterior a la adolescencia y las actividades econmicas que reflejaban la iniciativa individual en la primera etapa de la transicin tambin fomentaron el xito econmico. Sorprendentemente, la agencia adolescente tuvo efectos notables sobre el xito econmico de los adultos de casi 40 aos de edad que se haban criado y educado en una sociedad comunista con instituciones, normas y valores notablemente diferentes a los de la Estonia de 2004. © 2007 International Union of Psychological Science.},
	correspondence_address = {M. Titma; Sociology Department, Stanford University, Stanford, CA 94305-2047, United States; email: titma@stanford.edu},
	issn = {1464066X},
	language = {English},
	abbrev_source_title = {Int. J. Psychol.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
