@ARTICLE{Van Bavel2011313,
	author = {Van Bavel, Jan and Moreels, Sarah and Van de Putte, Bart and Matthijs, Koen},
	title = {Family size and intergenerational social mobility during the fertility transition: Evidence of resource dilution from the city of Antwerp in nineteenth century Belgium},
	year = {2011},
	journal = {Demographic Research},
	volume = {24},
	pages = {313 - 344},
	doi = {10.4054/DemRes.2011.24.14},
	url = {https://www.scopus.com/pages/publications/79955575824?origin=resultslist},
	affiliations = {Interface Demography, Vrije Universiteit Brussel, Belgium; Centre for Sociological Research, KULeuven, Belgium; Department of Sociology, Ghent University, Belgium},
	abstract = {It has been argued in sociology, economics, and evolutionary anthropology that family size limitation enhances the intergenerational upward mobility chances in modernized societies. If parents have a large flock, family resources get diluted and intergenerational mobility is bound to head downwards. Yet, the empirical record supporting this resource dilution hypothesis is limited. This article investigates the empirical association between family size limitation and intergenerational mobility in an urban, late nineteenth century population in Western Europe. It uses life course data from the Belgian city of Antwerp between 1846 and 1920. Findings are consistent with the resource dilution hypothesis: after controlling for confounding factors, people with many children were more likely to end up in the lower classes. Yet, family size limitation was effective as a defensive rather than an offensive strategy: it prevented the next generation from going down rather than helping them to climb up the social ladder. Also, family size appears to have been particularly relevant for the middle classes. Implications for demographic transition theory are discussed. © 2011 Jan Van Bavel et al.},
	correspondence_address = {J. Van Bavel; Interface Demography, Vrije Universiteit Brussel, Belgium; email: Jan.VanBavel@vub.ac.be},
	issn = {14359871},
	language = {English},
	abbrev_source_title = {Demogr. Res.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 43; All Open Access; Gold Open Access; Green Open Access}
}

@ARTICLE{Dardanoni201285,
	author = {Dardanoni, Valentino and Fiorini, Mario and Forcina, Antonio},
	title = {Stochastic monotonicity in intergenerational mobility tables},
	year = {2012},
	journal = {Journal of Applied Econometrics},
	volume = {27},
