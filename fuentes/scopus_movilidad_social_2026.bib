@ARTICLE{Hunter20102640,
	author = {Hunter, Mark},
	title = {Racial desegregation and schooling in South Africa: Contested geographies of class formation},
	year = {2010},
	journal = {Environment and Planning A},
	volume = {42},
	number = {11},
	pages = {2640 - 2657},
	doi = {10.1068/a439},
