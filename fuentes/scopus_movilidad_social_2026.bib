@ARTICLE{Nagpal2025504,
	author = {Nagpal, Sugandha and Srivastava, Vatsalya},
	title = {The Migrant as an Aspirational Actor: Developing Responsive Policies for Internal Migration in India},
	year = {2025},
	journal = {Sociological Bulletin},
	volume = {74},
	number = {4 Special Issue: Migration and Mobility},
	pages = {504 - 517},
	doi = {10.1177/00380229251349575},
	url = {https://www.scopus.com/pages/publications/105012852575?origin=resultslist},
	affiliations = {OP Jindal Global University, Jindal School of International Affairs, Haryana, Sonipat, India},
	abstract = {Much of the policy discussions and research on internal migration in India view the internal migrant as a purely economic actor shaped by structural forces of poverty, capitalism and agrarian distress. This perspective does not consider how the migrant actor is shaped by aspirations for class mobility, social integration or children’s education, among others. In this article, we identify the pandemic as a watershed moment that brings the complexity of migrant lives and aspirations into sharp focus. We analyse the experience of internal migrants during the pandemic through their observed responses to government policies and secondary research. We highlight the role of non-economic aspirations in shaping decision-making and experiences of internal migrants, as well as, the discrepancy between government policies and migrant aspirations. We argue that the processual view of aspirations should be applied to design responsive policy measures aligned with the lived realities of internal migrants. © 2025 Indian Sociological Society},
	author_keywords = {Aspirations; India; internal migrants; migration policy; mobility},
	correspondence_address = {S. Nagpal; OP Jindal Global University, Jindal School of International Affairs, Sonipat, Haryana, 131001, India; email: nagpalsugandha9@gmail.com},
