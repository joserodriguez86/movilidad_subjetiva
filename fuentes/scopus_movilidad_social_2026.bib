	affiliations = {Stanford Center on Poverty and Inequality, Stanford University, United States; University of Michigan, 426 Thompson St., Ann Arbor, 48106, MI, United States; Bremen International Graduate School of Social Sciences, United States; University of Wisconsin, United States; Federal Reserve Board of Governors, United States},
	abstract = {Recent studies of economic inequality almost always separately examine income inequality, consumption inequality, and wealth inequality, and hence, these studies miss the important synergy between the three measures explicit in the life-cycle budget constraint. Using the Panel Study of Income Dynamics (PSID), we study inequality in three dimensions, focusing on the conjoint distributions of income, consumption, and wealth for the same individuals. We find that the trends in inequality in income, consumption, and wealth similarly increase between 1999 and 2013. We examine the pairwise distributions of our measures using the average propensity to consume and the wealth-income ratios. Using the longitudinal nature of the PSID, we follow people over this period and find mobility is similar using income, consumption, and wealth. We conclude that while all three types of inequality are rising, wealth increasingly acts as a buffer to cushion income changes, which could reduce mobility - both intra-and inter-generational mobility. © 2018 W.B. Saunders. All Rights Reserved.},
