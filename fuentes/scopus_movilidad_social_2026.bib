@ARTICLE{Xiong2026146,
	author = {Xiong, Deping and Sun, Yilei and Yang, Mengyuan and Huang, Jirong},
	title = {Health Investment Enhances Intergenerational Income Mobility: Prevention or Treatment?; [健康投资增进代际收入流动性: 预防还是治疗?]},
	year = {2026},
	journal = {Modern Economic Science},
	volume = {48},
	number = {2},
	pages = {146 - 158},
	doi = {10.20069/j.cnki.DJKX.2026022},
	url = {https://www.scopus.com/pages/publications/105036839842?origin=resultslist},
	affiliations = {School of Finance, Yunnan University of Finance and Economics, Kunming, 650221, China; School of Economics, Yunnan University of Finance and Economics, Kunming, 650221, China},
	abstract = {Enhancing intergenerational income mobility is a core path to solidly advance common prosperity and achieve social equity. As a key human capital, the intergenerational transmission characteristics of health provide an important breakthrough for breaking income rigidity. However, existing studies mostly focus on the overall income effect of health investment, but neglect the heterogeneity and inherent correlation between preventive and curative health investments, resulting in the specific mechanisms of health investment influencing intergenerational income mobility not being fully revealed. Based on Grossman’s health demand theory, and using data from the 2019 China Household Finance Survey(CHFS), this paper explores the heterogeneous impacts of the two types of health investment on intergenerational income mobility. The findings indicate that both preventive and curative health investments can significantly promote intergenerational income mobility, and the promoting effect of preventive health investment is more prominent, which verifies the applicability of the concept of“prevention first, treatment supplementary”in the field of intergenerational income mobility. By further introducing the concept of“preventive elasticity of treatment”, it confirms the inherent correlation between preventive and curative health investments, and shows that there is an inverted U-shaped relationship between health investment structure and intergenerational income mobility, which suggests that optimizing the allocation ratio of preventive and curative health investments can effectively improve health investment efficiency. Heterogeneity analysis reveals that preventive health investment exerts a more significant promoting effect on intergenerational income mobility for male offspring, low-income families, and rural households, and this characteristic is closely related to urban-rural differences in medical resource distribution, occupational characteristics of different groups, and levels of health awareness. Compared with previous literature, the research contributions of this paper are: First, it breaks the limitation of existing research focusing on current income levels, expands the analytical perspective to the intergenerational dimension, and explores whether and how health investment affects intergenerational income mobility, providing policy implications for enhancing intergenerational income mobility; Second, based on the health demand theory, it distinguishes between preventive and curative health investments, and clarifies their heterogeneous effects in promoting intergenerational income mobility; Third, it proposes and demonstrates the concept of“preventive elasticity of treatment”for the first time, and on this basis, explores the nonlinear relationship between health investment structure and intergenerational income mobility, providing theoretical basis and empirical evidence for optimizing health investment structure and improving health investment efficiency. Based on the research conclusions, efforts should be made to strengthen the prevention orientation of public medical investment, implement differentiated urban-rural health investment strategies, expand the coverage of preventive projects in medical insurance, and at the same time enhance the promotion of health concepts to guide residents to form health investment behaviors characterized by“prevention priority, structural optimization”, so as to fully realize the positive role of health investment in promoting intergenerational income mobility and advancing common prosperity. © 2026, Editorial Board of Modern Economic Science. All rights reserved.},
	author_keywords = {curative health investment; health investment efficiency; health investment scale; health investment structure; health status; intergenerational income mobility; preventive health investment},
	correspondence_address = {J. Huang; School of Economics, Yunnan University of Finance and Economics, Kunming, 650221, China; email: 1482608544@qq.com},
	publisher = {Editorial Board of Modern Economic Science},
	issn = {10022848},
	language = {Chinese},
	abbrev_source_title = {Mod. Econ. Sci.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

