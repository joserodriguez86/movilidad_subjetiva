@ARTICLE{LI1979320,
	author = {LI, PETER S.},
	title = {A historical approach to ethnic stratification: the case of the Chinese in Canada, 1858–1930*},
	year = {1979},
	journal = {Canadian Review of Sociology/Revue canadienne de sociologie},
	volume = {16},
	number = {3},
	pages = {320 - 332},
	doi = {10.1111/j.1755-618X.1979.tb01034.x},
	url = {https://www.scopus.com/pages/publications/0018584658?origin=resultslist},
	affiliations = {University of Saskatchewan, Canada},
	abstract = {Bien que les modèles d'acquisition de situation aient apporté des contributions importantes en mettant en question l'approche culturelle par rapport à la stratification ethnique, une large partie des inégalités ethniques reste inexpliquée. Une part de cette lacune peut être comblée par l'examen du processus historique produisant des conditions de marché restreignant la participation d'un groupe ethnique sur le marché du travail. Ce travail retrace l'expérience des Chinois au Canada entre 1858 et 1930, et entend montrer que les choix de professions de la part des Chinois étaient en grande partie limités par les conditions du marché tels que la demande de main‐d'oeuvre à bon marché, et le développement d'un racisme institutionnel. L'apparition d'un marché du travail séparé ainsi que d'une force de travail chinoise occasionnelle peuvent être envisagées comme une conséquence du racisme institutionnel, alors que l'expansion des affaires ethniques constitue une réponse à un environnement hostile. Le cas des Chinois illustre l'efficacité des approches historiques dans le cadre de la stratification ethnique. While status attainment models have made important contributions in challenging the cultural approach to ethnic stratification, a substantial portion of ethnic inequality remains unexplained. Part of this gap may be filled by examining the historical process that produces those market conditions which restrict the participation of an ethnic group in the labour market. This paper traces the experience of the Chinese in Canada between 1858 and 1930, and argues that the occupational choices of Chinese were largely constrained by market conditions, such as the demand for cheap labour and the development of institutional racism. The emergence of a split labour market and a casual Chinese labour force may be viewed as consequences of institutional racism, while the rise of ethnic business, a response to a hostile environment. The case of the Chinese illustrates the efficacy of historical approaches in ethnic stratification. Copyright © 1979, Wiley Blackwell. All rights reserved},
	issn = {17556171},
	language = {English},
	abbrev_source_title = {Can. Rev. Sociol.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 16}
}

@ARTICLE{Strange197850,
	author = {Strange, Heather},
	title = {Education and Employment Patterns of Rural Malay Women 1965-1975},
	year = {1978},
	journal = {African and Asian Studies},
	volume = {13},
	number = {1-2},
	pages = {50 - 64},
	doi = {10.1163/156852178X00331},
	url = {https://www.scopus.com/pages/publications/34247992260?origin=resultslist},
	affiliations = {Rutgers University, Mew Brunswick, United States},
	abstract = {A majority of local people, males and females, continue to engage in village work. But success in upper secondary education is enabling increasing numbers of young people to qualify for wage-paying or salaried positions, usually outside of the village area. Larger numbers of children of both sexes are now continuing their education beyond the primary level. An examination of percentages of secondary students, by sex, indicates that a significant advance (at least 10%) has been made by women during the decade 1965 to 1975. There has been a shift from a majority of students attending “Arab schools” a decade ago to a majority enrolled in Malay-medium schools today. This suggests increasing secularization in the area and greater appreciation for academic rather than religion-oriented studies. The proximity of the new Malay-medium school and hence the reduced transportation costs entailed in getting to such a school is also a contributing factor to the shift. The reason most commonly given for denying children secondary education does continue to be an economic one. In general, the age at time of first marriage is rising but, as might be predicted, individuals who continue their education are marrying at a later age than their less educated peers. The greater the education the greater the departure is from participation in traditional marriage ceremonies and events. Marriage and children continue to be the most important goals of all women, whatever their educational attainment. The “housewife only” (ahli rumah saja) still has high prestige in the village, prestige which from an analytic view can be said to be a reflection of her husband’s economic position. The female worker with a regular income of her own enjoys similar prestige, prestige gained by her own accomplishments. Mothers holding salaried or wage-paying jobs, whether they live in towns or commute to their jobs from the village, are filling two demanding roles: wife/mother and paid worker. They are experiencing role conflict and worry about not devoting enough time to their children. Traditionally, village women with young children who worked outside of the home pursued their occupations on a part-time or spare-time basis in the village where they were readily available to their families if they were needed. Now, young women are holding positions which require their presence for regularly scheduled hours thus creating a new pattern of nonavailability to their families. Young children are placed in the care of housekeepers or “mothers’ helpers” on a daily basis, a new pattern of behavior which raises questions about socialization as well as creating both a new occupational role for women engaged in such work and a new social relationship employer-employee - between women from the same village area. The lifestyle changes for town-dwelling, educated persons are enormous, especially for those coming from average village families where both parents are illiterate. There is intergenerational mobility coupled with a tendency for the newly mobile individual to be pulled by two sometimes conflicting sets of values and norms. The conflict is heightened for the mother who holds a full time job outside of the home. Despite their role conflicts and the problems of living in two worlds simultaneously, these educationally/occupationally successful individuals serve as role models for younger people in their home villages. Male “success stories” in terms of education and regular income have been known in this area for several decades. Females have ventured far from the village for education and jobs only during the past few years. The first woman to make the big step did so with her own ability and courage backed by an illiterate mother who shared her daughter’s belief in the value of education for women as well as men and who worked and struggled against opposition to give her daughter the opportunity they both wanted. Others are following the example. © 1978, Brill. All rights reserved.},
	issn = {15692094},
	language = {English},
	abbrev_source_title = {Afr. Asian Stud.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 2}
}

