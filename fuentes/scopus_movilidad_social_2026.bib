@ARTICLE{Tin2026432,
	author = {Tin, Darapheak and Tran, Chung and Zakariyya, Nabeeh},
	title = {The Evolution of the Earnings Distribution in a Sustained Growth Economy: Evidence from Australia*},
	year = {2026},
	journal = {Economic Record},
	volume = {102},
