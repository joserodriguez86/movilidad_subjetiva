@ARTICLE{Kaiser2021713,
	author = {Kaiser, Caspar and Trinh, Nhat An},
	title = {Positional, Mobility, and Reference Effects: How Does Social Class Affect Life Satisfaction in Europe?},
	year = {2021},
	journal = {European Sociological Review},
	volume = {37},
	number = {5},
