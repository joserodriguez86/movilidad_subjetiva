@ARTICLE{Adkins200999,
	author = {Adkins, Daniel E. and Vaisey, Stephen},
	title = {Toward a unified stratification theory: Structure, genome, and status across human societies},
	year = {2009},
	journal = {Sociological Theory},
	volume = {27},
	number = {2},
	pages = {99 - 121},
	doi = {10.1111/j.1467-9558.2009.01339.x},
	url = {https://www.scopus.com/pages/publications/65149087108?origin=resultslist},
	affiliations = {University of North Carolina, United States; University of California, United States; Department of Sociology, CB 3210, Hamilton Hall, University of North Carolina at Chapel Hill, Chapel Hill, NC 27599-3210, United States},
	abstract = {While social scientists and geneticists have a shared interest in the personal characteristics instrumental to status attainment, little has been done to integrate these disparate perspectives. This is unfortunate, as the perspectives offer complementary insights, which, if properly combined, stand to substantially improve understanding of the stratification process. This article synthesizes research from the social sciences and genetics to develop a multistage theory of how social structure moderates the influence of the genome on status outcomes. Its thesis is that the strength of the genome's influence on status is primarily moderated by two properties of social structure - levels of resource inequality and social mobility. Thus, it is theorized that under conditions of low inequality and high social mobility, the influence of the genome on status will be high relative to conditions of high inequality and low social mobility. The essential logic is (1) as inequality increases, the characteristics and abilities intrinsically useful in status attainment are increasingly influenced by individuals' social backgrounds and decreasingly determined by their genomes; and (2) as social closure and inequality increase, the utility of these characteristics and abilities to status attainment is diminished. In sum, a model of status attainment is developed proposing that while both genome and social background influence the status attainment process, the relative importance of these factors is determined by the surrounding structure of the society. © American Sociological Association.},
	correspondence_address = {D. E. Adkins; Department of Sociology, CB 3210, Hamilton Hall, University of North Carolina at Chapel Hill, Chapel Hill, NC 27599-3210, United States; email: adkins@unc.edu},
	issn = {14679558},
	language = {English},
	abbrev_source_title = {Sociol. Theory},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 45}
}

