	title = {Inclusion Without Dignity: How African Australians Resist Assimilationist Narratives as Conditions of Belonging},
	year = {2026},
	journal = {Journal of Sociology},
	pages = {},
	doi = {10.1177/14407833261450251},
	url = {https://www.scopus.com/pages/publications/105047505623?origin=resultslist},
	affiliations = {College of Human Sciences and Culture, Flinders University, Australia},
	abstract = {Multiculturalism in Australia is predominantly framed as a benevolent process of “inclusion and diversification”. It promises equity, participation, and belonging for racialized minorities, as well as a pathway to ‘social cohesion’. Inclusion, as it is widely understood, implies equitable access to systems, spaces, and institutions. These enable social and economic mobility while safeguarding belonging and safety. However, for African Australians, “inclusion projects” often fail to protect against racial harm and can instead reproduce assimilationist expectations that demand compliance and a collapse into whiteness as the condition of acceptance. Drawing on in-depth qualitative research, this article interrogates the limitations of inclusion as a framework for addressing the “challenges” of belonging. It proposes racial dignity as a more expansive concept that has remained largely unaddressed in Australian political and social dialogues on integration, social cohesion, and belonging. Against this backdrop, we read participants’ resistance as politics of refusal. Here, refusing indignity and insisting on “living with dignity” directly challenge the hierarchical distribution of belonging. Refusal signals that belonging is not a reward to be “granted” by those in power, but a practice that can be cultivated, defended, and expanded by those who are marginalized, excluded or cast as unworthy of belonging. By reframing belonging as an outcome of dignity rather than inclusion, this article redirects the debate toward how dignity is re/claimed in sites where belonging is produced through indignifying processes. © The Author(s) 2026. This article is distributed under the terms of the Creative Commons Attribution-NonCommercial 4.0 License (https://creativecommons.org/licenses/by-nc/4.0/) which permits non-commercial use, reproduction and distribution of the work without further permission provided the original work is attributed as specified on the SAGE and Open Access page (https://us.sagepub.com/en-us/nam/open-access-at-sage).},
	author_keywords = {African Australians; Australia; belonging; Black Africans; inclusion; racial dignity},
	correspondence_address = {K. Gatwiri; College of Human Sciences and Culture, Flinders University, Bedford Park, Sturt Road, 5042, Australia; email: kathomi.gatwiri@flinders.edu.au},
	publisher = {SAGE Publications Ltd},
	issn = {14407833},
	language = {English},
	abbrev_source_title = {J. Sociol.},
	type = {Article},
	publication_stage = {Article in press},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Hybrid Gold Open Access}
}

@ARTICLE{Woo-Mora2026,
	author = {Woo-Mora, L. Guillermo},
	title = {Unveiling the Cosmic Race: Skin tone and intergenerational economic disparities in Latin America and the Caribbean},
	year = {2026},
	journal = {Journal of Development Economics},
	volume = {179},
	pages = {},
	doi = {10.1016/j.jdeveco.2025.103594},
	url = {https://www.scopus.com/pages/publications/105015342652?origin=resultslist},
	affiliations = {Paris School of Economics and EHESS, France},
	abstract = {This paper examines how skin tone shapes intergenerational economic disparities across 25 Latin American and Caribbean countries. First, it analyzes the distribution of ethnoracial identities and skin tone, confirming Mestizo predominance and revealing how broad categories obscure substantial phenotypic diversity. Second, it documents non-linear gaps in income and education, with darker skin tones consistently linked to economic disadvantages. A variance decomposition shows that skin tone explains significant within-group variation, offering explanatory power beyond self-reported ethnoracial categories. Finally, using mothers’ education as a benchmark, the study provides novel cross-country evidence on skin tone gaps in absolute educational intergenerational mobility, revealing barriers to upward mobility for darker-skinned individuals. Robustness checks with machine-assessed skin tone data from Mexico, incorporating additional parental and contextual controls, confirm these disparities. These findings underscore the need to account for phenotypic variation when studying economic inequality in Latin America. © 2025 Elsevier B.V.},
	author_keywords = {Inequality; Intergenerational mobility; Latin America; Race; Skin tone},
	keywords = {Caribbean Islands; Latin America; decomposition analysis; race; racial identity; variance analysis},
	publisher = {Elsevier B.V.},
	issn = {03043878},
	language = {English},
	abbrev_source_title = {J. Dev. Econ.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 5}
}

@ARTICLE{Bernard2026,
	author = {Bernard, Josef and Soukup, Petr and Boháček, Radim},
	title = {Regional perspective on status attainment in Czechia: A life-course approach},
	year = {2026},
	journal = {Research in Social Stratification and Mobility},
	volume = {106},
	pages = {},
	doi = {10.1016/j.rssm.2026.101204},
	url = {https://www.scopus.com/pages/publications/105051384617?origin=resultslist},
	affiliations = {Institute of Sociology, Czech Academy of Sciences, Czech Republic; Faculty of Social Sciences, Charles University, Czech Republic; CERGE-EI, Czech Republic},
	abstract = {Regional disparities in social mobility and status attainment raise significant concerns about unequal geographic opportunities and the place-based mechanisms that drive inequality. This study advances the literature by disentangling the role of regions at distinct stages of the status attainment process across the life course. Using data from the Czech sample of the Survey of Health, Ageing and Retirement in Europe (SHARE), we examine the status-related associations of childhood and adulthood region of residence during both the educational and occupational stages of status attainment. The results show that childhood region is strongly directly associated with educational attainment, which subsequently shapes occupational outcomes later in life. Notably, the capital city of Prague is consistently linked to higher social status: both growing up in Prague and relocating there in adulthood are associated with higher status levels. Moreover, the indirect relationship with childhood region remain more influential at later career stages than direct associations with adulthood residence. These findings underscore the role of geographically unequal access to educational opportunities and labour market advantages related to residence in the capital region. Copyright © 2026. Published by Elsevier Ltd.},
	author_keywords = {Czechia; Life course; Regional effects; Social mobility; Status attainment},
	correspondence_address = {J. Bernard; Institute of Sociology, Czech Academy of Sciences, Czech Republic; email: josef.bernard@soc.cas.cz},
	publisher = {Elsevier Ltd},
	issn = {02765624},
	language = {English},
	abbrev_source_title = {Res. Soc. Stratification Mobil.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@ARTICLE{Gniewosz2026,
	author = {Gniewosz, Gabriela and Walper, Sabine},
	title = {Early insights into intergenerational education mobility and emotional problems during the transition to secondary school in Germany},
	year = {2026},
	journal = {Research in Social Stratification and Mobility},
	volume = {103},
	pages = {},
	doi = {10.1016/j.rssm.2026.101149},
	url = {https://www.scopus.com/pages/publications/105035792034?origin=resultslist},
	affiliations = {University Innsbruck, Education, Innsbruck, Austria; German Youth Institute (DJI), Munich, Germany},
	abstract = {Social inequalities in education due to early tracking in the German school system have been widely discussed, but little is known about the role of emotional problems at this critical point in children’s educational careers. This paper examines whether emotional problems prevent intergenerational upward mobility among children at the transition from primary to secondary school and investigates subsequent changes in emotional problems among four mobility groups (upward, downward, stable high, stable low). The study analyzes longitudinal data from 630 students between 3rd and 6th grade. Based on Latent Change Score Models (LCSMs), the findings indicate that (1) children’s emotional problems generally increased from 3rd to 6th grade, (2) elevated pre-transition problems significantly reduced the likelihood of upward intergenerational mobility, and (3) the most pronounced increases in emotional problems following the transition were observed among children in the stable high educational group. These results suggest that emotional problems not only hinder but also reflect heightened performance-related stress in the more demanding secondary school context, particularly for intergenerational status retention. All analyses controlled for key covariates, including gender and academic performance. © 2026 The Authors.},
	author_keywords = {Early adolescence; Educational mobility; Emotional problems; Longitudinal study},
	correspondence_address = {G. Gniewosz; University Innsbruck, Education, Innsbruck, Austria; email: gabriela.gniewosz@uibk.ac.at},
	publisher = {Emerald Publishing},
	issn = {02765624},
	language = {English},
