@ARTICLE{Yu2025821,
	author = {Yu, Ang and Elwert, Felix},
	title = {NONPARAMETRIC CAUSAL DECOMPOSITION OF GROUP DISPARITIES},
	year = {2025},
	journal = {Annals of Applied Statistics},
