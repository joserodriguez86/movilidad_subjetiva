@ARTICLE{Schwarz20241,
	author = {Schwarz, Anna and Warum, Philipp},
	title = {Don't stop believin’: Income group heterogeneity in updating of social mobility beliefs},
	year = {2024},
	journal = {Journal of Economic Behavior and Organization},
	volume = {225},
	pages = {1 - 19},
	doi = {10.1016/j.jebo.2024.06.029},
