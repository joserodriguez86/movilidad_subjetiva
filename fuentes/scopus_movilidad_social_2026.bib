@ARTICLE{Sicsic20233,
	author = {Sicsic, Michaël},
	title = {Who Climbs Up the Income Ladder? An Analysis of Intergenerational Income Mobility in France; [Qui est mieux classé que ses parents dans l’échelle des revenus ? Une analyse de la mobilité intergénérationnelle en France]},
	year = {2023},
	journal = {Economie et Statistique},
	volume = {2023},
	number = {540},
	pages = {3 - 20},
	doi = {10.24187/ecostat.2023.540.2100},
	url = {https://www.scopus.com/pages/publications/85177074403?origin=resultslist},
	affiliations = {Insee au moment de l’étude, et CRED, Université Paris 2 Panthéon-Assas, France},
	abstract = {We study the intergenerational income mobility of individuals by directly comparing, for the first time in France, the rank of young adults between the ages of 27 and 30 on the income ladder with that of their parents, based on administrative data from the Échantillon démographique permanent (EDP, INSEE’s demographic panel sample). The rank-rank correlation is 0.25 at age 29. Twelve per cent of the young people born to the poorest 20% of parents climb up the income ladder to the top 20%: this upward mobility rate is higher in France than in the United States and Italy, but lower than in the Nordic countries. Upward mobility is stronger the higher the parents’ capital incomes and diploma, when parents are immigrants, are geographically mobile, or were living in Île-de-France when their offspring reached the age of majority. Conversely, being female, having lived in a single-parent family or in the Hauts-de-France region, or having parents who are manual worker has a negative impact on upward mobility. © 2023, Institut National de la Statistique et des Etudes Economiques. All rights reserved.},
	author_keywords = {geographical variations; income; inequality; intergenerational mobility},
	correspondence_address = {M. Sicsic; Insee au moment de l’étude, et CRED, Université Paris 2 Panthéon-Assas, France; email: sicsic.michael@gmail.com},
