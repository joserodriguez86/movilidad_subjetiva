@ARTICLE{Bethmann2013307,
	author = {Bethmann, Arne},
	title = {Occupational change and status mobility: The detrimental effects of unemployment and the loss of occupation specific human capital; [Berufswechsel und Statusmobilität: Die nachteiligen Effekte von Arbeitslosigkeit und der Verlust von berufsspezifischem Humankapital]},
