	title = {Optimism predicts future economic mobility among hurricane maria migrants},
	year = {2026},
	journal = {Climate and Development},
	pages = {},
	doi = {10.1080/17565529.2026.2664557},
	url = {https://www.scopus.com/pages/publications/105040695221?origin=resultslist},
	affiliations = {Department of Kinesiology and Health Education, University of Texas at Austin, Austin, TX, United States; The Self-Governance Institute, Austin, TX, United States; College of Communication, University of Texas at Austin, Austin, TX, United States; School of Social Work, Boston College, Boston, MA, United States; Department of Health Education & Behavior, University of Florida, Gainesville, FL, United States; School of Education, University of Texas at Austin, Austin, TX, United States; School of Public Health, Texas A&M, College Station, TX, United States; University of Basel, Institute for Educational Sciences, Basel, Switzerland; Iglesia Episcopal Jesús de Nazaret, Orlando, FL, United States},
	abstract = {In the United States, the frequency and severity of climate-related disasters continue to rise, leading to increased displacement of individuals and families. Those forcibly displaced often face heightened uncertainty, vulnerability to mental and cultural stressors, and economic insecurity. Economic mobility during and after resettlement may, to some extent, be a function of migrant adaptation, mental health, and psychological functioning. However, the underlying mechanisms linking these factors remain poorly understood among climate crisis migrants, many of whom, despite pre- and post-migration adversity, achieve upward economic mobility in their new environments. To explore this issue, we estimated a longitudinal structural equation model, using five waves of data from 319 adult Puerto Rican migrants displaced to the U.S. mainland by Hurricane Maria. We examined the predictive effect of post-traumatic stress symptoms (PTSS) on economic mobility, as well as the mediating roles of optimism/pessimism, cultural stressors, and internalizing symptoms in this predictive association. We found that PTSS was significantly and positively associated with economic mobility over time, but this relationship was associated exclusively through components of optimism (specifically, coping with uncertainty). No significant associations were observed through other components of optimism/pessimism, cultural stress, or internalizing symptoms. © 2026 Informa UK Limited, trading as Taylor & Francis Group.},
	author_keywords = {anxiety; crisis migration; cultural stress; depression; discrimination; income; Optimism; pessimism; trauma},
